{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/var/lib/vesessionmanager/vesessionmanager.db"
  },
  // Pinned (2026-08-03): the framework default "*" accepts any Host header, which combined with
  // absolute URLs built from the request would let an attacker request a password reset for a known
  // admin and have the genuine, correctly-signed email point at their own server. The reset link no
  // longer reads the request host at all (it uses App:PublicBaseUrl — see ForgotPassword), so this
  // is the second of two independent defences rather than the only one.
  "AllowedHosts": "ve.wx0mik.radio",
  "App": {
    "PublicBaseUrl": "https://ve.wx0mik.radio"
  },


  // The form's processing URL, query flag included -- the bare page URL renders the form and
  // processes nothing, answering 200 with the empty form, which reads as success to anything
  // checking status codes. Every POST here files a real session and cannot be undone.
  "ArrlSubmission": {
    "UploadUrl": "https://www.arrl.org/vec-upload.php?processed=1",
    // Outside the app directory: deploy.yml runs rsync --delete over that on every release,
    // which is why the database lives under /var/lib too. Needs adding to the off-box backup.
    "ArchiveRootPath": "/var/lib/vesessionmanager/vec-archives"
  },

  "DataProtection": {
    "KeyRingPath": "/var/lib/vesessionmanager-keys"
  }
}
