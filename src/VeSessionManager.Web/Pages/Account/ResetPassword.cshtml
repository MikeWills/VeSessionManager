@page
@model VeSessionManager.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Choose a new password";
    Layout = "_PublicLayout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Choose a new password</h1>

        @if (Model.Errors.Count > 0)
        {
            <div class="auth-error">
                @foreach (var error in Model.Errors)
                {
                    <div>@error</div>
                }
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            @* The token is a bearer credential for this account — round-tripped only, never shown. *@
            <input type="hidden" asp-for="Input.UserId" />
            <input type="hidden" asp-for="Input.Token" />
            <div class="field">
                <label asp-for="Input.NewPassword"></label>
                <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.NewPassword" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="field-error"></span>
            </div>
            <button type="submit" class="btn-primary">Set new password</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
