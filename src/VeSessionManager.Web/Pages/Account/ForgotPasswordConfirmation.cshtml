@page
@model VeSessionManager.Web.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
    Layout = "_PublicLayout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Check your email</h1>
        @* Worded to reveal nothing about whether an account exists — this same page is shown for an
           address with no account, a deactivated account, and an OAuth-only account. *@
        <p class="session-sub">
            If that address belongs to an account that signs in with a password, a reset link is on its
            way. The link expires after a short time; if it doesn't arrive, check your spam folder or
            ask your administrator.
        </p>
        <a asp-page="/Account/Login">Back to log in</a>
    </div>
</div>
