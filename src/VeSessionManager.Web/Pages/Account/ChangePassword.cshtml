@page
@model VeSessionManager.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Your account</p>
        <h1>Change password</h1>
    </div>
</div>

@if (!Model.HasLocalPassword)
{
    @* An external-login account has no local password. Showing the form would be a dead end. *@
    <div class="session-panel">
        <p>You sign in through an external provider, so there is no password here to change. Manage it with that provider instead.</p>
    </div>
}
else
{
    @if (Model.IsForced)
    {
        <div class="flag-banner">
            <b>Choose your own password.</b>
            This account was created with a password an administrator chose, so at least one other person knows it. You will be brought back here until it is replaced.
        </div>
    }

    @if (Model.ErrorMessage is not null)
    {
        <div class="vesm-alert error">@Model.ErrorMessage</div>
    }

    <div class="session-panel" style="max-width:420px;">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="vesm-alert error"></div>
            <div class="field">
                <label asp-for="Input.CurrentPassword"></label>
                <input asp-for="Input.CurrentPassword" type="password" autocomplete="current-password" required />
                <span asp-validation-for="Input.CurrentPassword" class="session-sub"></span>
            </div>
            <div class="field">
                <label asp-for="Input.NewPassword"></label>
                <input asp-for="Input.NewPassword" type="password" autocomplete="new-password" required />
                <span asp-validation-for="Input.NewPassword" class="session-sub"></span>
            </div>
            <div class="field">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" type="password" autocomplete="new-password" required />
                <span asp-validation-for="Input.ConfirmPassword" class="session-sub"></span>
            </div>
            <div class="panel-actions" style="margin-top:16px;">
                <button type="submit" class="btn-primary">Change password</button>
            </div>
        </form>
    </div>
}

@* Without this, asp-validation-for renders the markup but nothing populates it: every check becomes
   a round trip and the message only appears after a POST. Server-side validation is unaffected and
   remains the actual enforcement (#314, L-15). *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
