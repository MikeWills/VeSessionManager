@page
@model VeSessionManager.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = "_PublicLayout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Log in</h1>

        @if (Model.ErrorMessage is not null)
        {
            <div class="auth-error">@Model.ErrorMessage</div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div class="field">
                <label asp-for="Input.UserName"></label>
                <input asp-for="Input.UserName" autocomplete="username" />
                <span asp-validation-for="Input.UserName" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>
            <button type="submit" class="btn-primary">Log in</button>
        </form>

        @if (Model.ExternalLogins.Count > 0)
        {
            <div class="auth-divider">or</div>
            <form method="post">
                @foreach (var provider in Model.ExternalLogins)
                {
                    <button type="submit" class="btn-secondary" name="provider" value="@provider.Name" asp-page-handler="ExternalLogin">
                        Sign in with @provider.DisplayName
                    </button>
                }
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
