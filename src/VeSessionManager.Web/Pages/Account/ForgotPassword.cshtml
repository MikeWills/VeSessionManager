@page
@model VeSessionManager.Web.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_PublicLayout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Forgot password</h1>

        @if (Model.ErrorMessage is not null)
        {
            <div class="auth-error">@Model.ErrorMessage</div>
        }

        <p class="session-sub">Enter the email address you sign in with and we'll send you a link to choose a new password.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="field-error"></div>
            <div class="field">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="field-error"></span>
            </div>
            <button type="submit" class="btn-primary">Send reset link</button>
        </form>

        <div class="auth-divider">or</div>
        <a asp-page="/Account/Login">Back to log in</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
