@page
@model IndexModel
@{
    ViewData["Title"] = "Welcome";
    Layout = "_PublicLayout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>VE Session Manager</h1>
        <p>Automates Zoom scheduling, payment links, and candidate emails for amateur radio VE testing sessions.</p>
        @* No Privacy link here: _PublicLayout's footer carries one site-wide, and this page's own
           copy sat directly above it — two identical links, inches apart. Login/ForgotPassword etc.
           already rely on the layout for this; this page was the only holdout. *@
        <a class="btn-primary" style="display:block;text-align:center;" asp-page="/Account/Login">Log in</a>
    </div>
</div>
