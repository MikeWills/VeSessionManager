@page "{id:int}"
@using VeSessionManager.Core.Messaging
@model VeSessionManager.Web.Pages.Admin.EmailTemplateEditModel
@{
    ViewData["Title"] = Model.Label;
    ViewData["ActiveNav"] = "AdminEmailTemplates";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow"><a asp-page="/Admin/EmailTemplates" asp-route-teamId="@Model.Template.TeamId">Email Templates</a></p>
        <h1>@Model.Label</h1>
    </div>
    <span style="display:inline-flex; gap:8px; align-items:center;">
        <a class="btn-secondary btn-sm" asp-page="/Admin/EmailTemplatePreview" asp-route-id="@Model.Id">Preview</a>
        @if (Model.Template.IsUserDefined)
        {
            <button type="button" class="btn-danger btn-sm" data-open-modal="deleteTemplateModal">Delete</button>
        }
    </span>
</div>

@* What actually causes this email to go out. Two of these are genuinely surprising —
   PaymentExpirationNotice goes to the team rather than the candidate, and FelonyDisclosureInstructions
   has no automatic trigger at all — so this is the difference between editing a template knowingly
   and guessing. See EmailTemplateTriggers. *@
@if (Model.IsRetired)
{
    <div class="vesm-alert error">
        <b>No longer sent.</b> Nothing in the app sends this template any more. It stays here because
        seeding never deletes, so any wording you added is preserved — but editing it has no effect.
    </div>
}
else if (Model.Trigger is { } trigger)
{
    @* Only the templates a person sends by hand carry a written description now — anything a rule
       sends is described by the rule, on Message Rules, where the numbers are actually true (#401). *@
    <div class="template-trigger">
        <span class="chip chip-neutral">By hand</span>
        <span class="chip chip-neutral">@trigger.Recipient</span>
        <p>@trigger.Description</p>
    </div>
}
@* Exactly one rule sends this, so the schedule is editable right here — writing the wording and
   deciding when it goes are one job, and making it two screens was the first thing to trip somebody
   up. The trigger itself is shown but not settable: a rule's run markers are keyed to it and a
   SubjectId means a candidate under one trigger and a payment under another, so moving a rule between
   triggers would reinterpret every marker it has already written, and the visible consequence is a
   re-send. Wanting a different moment means wanting a different rule. *@
else if (Model.SendingRules.Count == 1)
{
    var rule = Model.SendingRules[0];
    <div class="session-panel" style="display:block; margin-bottom:20px;">
        <form method="post" asp-page-handler="Schedule">
            <input type="hidden" name="ruleId" value="@rule.Id" />
            <div class="section-head">
                <div>
                    <h2 style="margin:0;">Sends @rule.TriggerLabel.ToLowerInvariant()</h2>
                    <p class="session-sub" style="margin:4px 0 0;">
                        By the rule "@rule.Name".
                        @if (!rule.IsEnabled)
                        {
                            <strong>Currently switched off</strong><text>, so nothing is being sent.</text>
                        }
                        <a asp-page="/Admin/MessageRules" asp-route-teamId="@Model.Template.TeamId">All message rules</a>
                    </p>
                </div>
            </div>

            <div style="display:flex; gap:16px; flex-wrap:wrap; align-items:flex-end;">
                @if (rule.TakesParameter)
                {
                    <div class="field" style="max-width:220px; margin:0;">
                        <label for="scheduleDays">@rule.ParameterPrompt</label>
                        <input id="scheduleDays" name="parameterDays" type="number"
                               min="@MessageDelay.Format(MessageDelay.Minimum)"
                               max="@MessageDelay.Format(MessageDelay.Maximum)"
                               step="@MessageDelay.Format(MessageDelay.Step)"
                               value="@rule.ParameterDaysText" required />
                        @* Days on the form, hours in the column, and that is not a cosmetic split: a
                           duration between two instants has no calendar date in it, so there is no
                           timezone for an evening session to get wrong (#220). Halves keep "12 hours
                           before" reachable. *@
                        <span class="session-sub">Whole or half days — 0.5 is twelve hours.</span>
                    </div>
                }
                @if (rule.Channel == VeSessionManager.Core.Entities.MessageChannel.Email)
                {
                    <div class="field" style="max-width:260px; margin:0;">
                        <label for="scheduleRecipient">Who receives it</label>
                        <select id="scheduleRecipient" name="recipient" class="filter-select">
                            @foreach (var recipient in rule.LegalRecipients)
                            {
                                <option value="@((int)recipient)" selected="@(recipient == rule.Recipient)">
                                    @MessageTriggerLabels.Label(recipient)
                                </option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="field" style="margin:0;">
                        <span class="label-text">Posted to Discord</span>
                        <span class="session-sub">Channel and fan-out are set on the rule.</span>
                    </div>
                }
                <button type="submit" class="btn-secondary btn-sm">Save schedule</button>
            </div>
        </form>
    </div>
}
else if (Model.SendingRules.Count > 1)
{
    @* Two rules means "the schedule" has no single answer, so this links out rather than guessing
       which one somebody meant. *@
    <div class="template-trigger">
        @foreach (var rule in Model.SendingRules)
        {
            <a asp-page="/Admin/MessageRuleEdit" asp-route-id="@rule.Id" title="Edit &quot;@rule.Name&quot;">
                <span class="chip @(rule.IsEnabled ? "chip-green" : "chip-neutral")">@rule.When</span>
            </a>
        }
        <p>
            Sent by @Model.SendingRules.Count rules — pick one above, or see them all on
            <a asp-page="/Admin/MessageRules" asp-route-teamId="@Model.Template.TeamId">Message Rules</a>.
        </p>
    </div>
}
else if (!Model.IsRetired)
{
    <div class="template-trigger">
        <span class="chip chip-neutral">Not sent automatically</span>
        <p>
            Nothing sends this on a schedule. Add a rule on
            <a asp-page="/Admin/MessageRules" asp-route-teamId="@Model.Template.TeamId">Message Rules</a>
            to make it automatic.
        </p>
    </div>
}

@if (Model.Template.IsUserDefined)
{
    <div class="session-panel" style="display:block; margin-bottom:20px;">
        <form method="post" asp-page-handler="Rename" style="display:flex; gap:8px; align-items:flex-end;">
            <div class="field" style="max-width:320px; margin:0;">
                <label for="templateName">Name</label>
                <input id="templateName" name="name" value="@Model.Template.DisplayName" required />
            </div>
            <button type="submit" class="btn-secondary btn-sm">Rename</button>
        </form>
    </div>
}

<form method="post">
    @* Chips are click-to-insert (see email-template-editor.js) — typing a placeholder by hand is the
       easiest thing to get wrong here, and a typo only surfaces as a Worker log warning after a real
       send. Rendered as buttons so they're keyboard-reachable. *@
    <div class="roster-list" style="margin-bottom:12px;">
        @foreach (var placeholder in Model.Placeholders)
        {
            <button type="button" class="chip chip-neutral placeholder-chip" data-token="{{@placeholder}}"
                    title="Insert this placeholder">{{@placeholder}}</button>
        }
    </div>

    <div class="field"><label for="subject">Subject</label><input id="subject" asp-for="Subject" required /></div>

    @* The textarea remains the field that posts, in both tabs — Quill is a second view onto it, never
       a replacement. Without JS the page degrades to exactly what it was before: a plain textarea. *@
    <div class="field template-editor">
        <label for="body">Body</label>
        <div class="editor-tabs" role="tablist">
            <button type="button" class="editor-tab" role="tab" data-mode="visual" aria-selected="true">Visual</button>
            <button type="button" class="editor-tab" role="tab" data-mode="html" aria-selected="false">HTML</button>
        </div>
        <div class="editor-visual" data-editor-for="body">
            <div class="editor-surface"></div>
        </div>
        <textarea id="body" asp-for="Body" rows="16" required></textarea>
    </div>

    <div class="panel-actions">
        <a class="btn-secondary" asp-page="/Admin/EmailTemplates" asp-route-teamId="@Model.Template.TeamId">Cancel</a>
        <button type="submit" class="btn-primary">Save</button>
    </div>
</form>

@if (Model.Template.IsUserDefined)
{
    <div class="modal-backdrop" id="deleteTemplateModal">
        <div class="modal">
            <h3>Delete "@Model.Template.DisplayName"?</h3>
            <p>
                The template goes for good. Emails already sent from it are unaffected, and the
                candidates who received them keep showing it in their email history.
                <b>This cannot be undone.</b>
            </p>
            <form method="post" asp-page-handler="Delete">
                <div class="modal-actions">
                    <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                    <button type="submit" class="btn-danger btn-sm">Delete template</button>
                </div>
            </form>
        </div>
    </div>
}

@section Head {
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
}

@section Scripts {
    <script src="~/lib/quill/quill.js"></script>
    <script src="~/js/email-template-editor.js" asp-append-version="true"></script>
}
