@page
@model VeSessionManager.Web.Pages.Admin.VecsModel
@{
    ViewData["Title"] = "VECs";
    ViewData["ActiveNav"] = "AdminVecs";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Shared / global reference data</p>
        <h1>VECs</h1>
    </div>
    <button type="button" class="btn-primary" data-open-modal="createVecModal">+ New VEC</button>
</div>

<div class="table-scroll">
<table class="cards" data-sortable="vecs">
    <thead>
        <tr>
            <th>Name</th>
            <th>ExamTools code</th>
            <th>Fees</th>
            <th>Youth program</th>
            <th>Notes</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Vecs.Count == 0)
        {
            <tr><td colspan="6">No VECs yet.</td></tr>
        }
        @foreach (var vec in Model.Vecs)
        {
            <tr>
                <td class="session-title">@vec.Name</td>
                <td>
                    @if (vec.ExamToolsCode is null)
                    {
                        <span class="chip chip-neutral">Same as name</span>
                    }
                    else
                    {
                        <code>@vec.ExamToolsCode</code>
                    }
                </td>
                <td>
                    @if (vec.FeeSummary is null)
                    {
                        @* Not cosmetic: with no fee configuration in effect, ingestion skips every
                           session under this VEC and only says so in the Worker log. *@
                        <span class="chip chip-brick">No fee config — sessions skipped</span>
                    }
                    else
                    {
                        <span class="chip chip-neutral">@vec.FeeSummary</span>
                    }
                </td>
                <td>
                    @if (vec.SupportsYouthProgram)
                    {
                        <span class="chip chip-green">Supported</span>
                    }
                    else
                    {
                        <span class="chip chip-neutral">Not supported</span>
                    }
                </td>
                <td>@vec.Notes</td>
                <td class="row-actions">
                    <button type="button" class="kebab" aria-label="Actions"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
                    <div class="menu">
                        <button type="button" class="item" data-open-modal="editVecModal-@vec.Id">Edit</button>
                        <a class="item" asp-page="/Admin/FeeConfigurations" asp-route-vecId="@vec.Id">Fee configurations</a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<div class="modal-backdrop" id="createVecModal">
    <div class="modal">
        <h3>New VEC</h3>
        <form method="post" asp-page-handler="Create">
            <div class="field"><label for="createVecName">Name</label><input id="createVecName" name="name" required /></div>
            <div class="field">
                <label for="createVecExamToolsCode">ExamTools code</label>
                <input id="createVecExamToolsCode" name="examToolsCode" placeholder="Leave blank if the same as the name" />
                <p class="session-sub">ExamTools' own <code>vec</code> value for this VEC's sessions, if it differs from the name — GLAARG reports <code>lagroup</code>. Sessions are matched on this, so a mismatch means they never ingest.</p>
            </div>
            <div class="field">
                <label><input type="checkbox" name="supportsYouthProgram" value="true" style="width:auto; display:inline-block;" /> Supports youth program</label>
            </div>
            <div class="field"><label for="createVecNotes">Notes</label><textarea id="createVecNotes" name="notes" rows="2"></textarea></div>
            <div class="modal-actions">
                <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                <button type="submit" class="btn-primary btn-sm">Create</button>
            </div>
        </form>
    </div>
</div>

@foreach (var vec in Model.Vecs)
{
    <div class="modal-backdrop" id="editVecModal-@vec.Id">
        <div class="modal">
            <h3>Edit VEC</h3>
            <form method="post" asp-page-handler="Update">
                <input type="hidden" name="vecId" value="@vec.Id" />
                <div class="field"><label for="editVecName-@vec.Id">Name</label><input id="editVecName-@vec.Id" name="name" value="@vec.Name" required /></div>
                <div class="field">
                    <label for="editVecExamToolsCode-@vec.Id">ExamTools code</label>
                    <input id="editVecExamToolsCode-@vec.Id" name="examToolsCode" value="@vec.ExamToolsCode" placeholder="Leave blank if the same as the name" />
                    <p class="session-sub">ExamTools' own <code>vec</code> value for this VEC's sessions, if it differs from the name — GLAARG reports <code>lagroup</code>. Sessions are matched on this, so a mismatch means they never ingest.</p>
                </div>
                <div class="field">
                    <label><input type="checkbox" name="supportsYouthProgram" value="true" checked="@vec.SupportsYouthProgram" style="width:auto; display:inline-block;" /> Supports youth program</label>
                </div>
                <div class="field"><label for="editVecNotes-@vec.Id">Notes</label><textarea id="editVecNotes-@vec.Id" name="notes" rows="2">@vec.Notes</textarea></div>
                <div class="modal-actions">
                    <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                    <button type="submit" class="btn-primary btn-sm">Save</button>
                </div>
            </form>
        </div>
    </div>
}
