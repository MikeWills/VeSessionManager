@page
@model VeSessionManager.Web.Pages.Admin.EmailTemplatesModel
@{
    ViewData["Title"] = "Email Templates";
    ViewData["ActiveNav"] = "AdminEmailTemplates";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Per team</p>
        <h1>Email Templates</h1>
    </div>
</div>

@if (Model.IsSystemAdmin)
{
    @* Same team-picker component as the session list, deliberately WITHOUT an "All teams" option:
       this page edits one team's configuration, so a merged view has no meaning. The trigger reads
       "Select a team…" until one is chosen, matching the prompt below. *@
    <form method="get" id="teamFilter" class="filters" style="margin-bottom:16px; align-items:flex-start;">
        <div class="filter-dropdown">
            <button type="button" class="kebab @(Model.TeamId is not null ? "active" : "")">Team: @Model.TeamSummaryLabel ▾</button>
            <div class="menu">
                @foreach (var team in Model.AvailableTeams)
                {
                    <label class="item"><input type="radio" name="teamId" value="@team.Id" @(team.Id == Model.TeamId ? "checked" : "") /> @team.Name</label>
                }
                <hr />
                <button type="submit" class="item">Apply</button>
            </div>
        </div>
    </form>
}

@if (Model.TeamId is null)
{
    <p>@(Model.IsSystemAdmin ? "Pick a team above." : "No team assigned to this account.")</p>
}
else if (Model.Templates.Count == 0)
{
    <p>No templates seeded for this team yet.</p>
}
else
{
    @foreach (var template in Model.Templates)
    {
        <div class="session-panel" style="display:block; margin-bottom:20px;">
            <div class="section-head">
                <h2 class="mono">@template.Key</h2>
                @if (template.UpdatedUtc is not null)
                {
                    <span class="session-sub">Last updated @EasternTimeFormatter.Format(template.UpdatedUtc.Value, "MMM d, yyyy h:mm tt")</span>
                }
            </div>
            @* Chips are now click-to-insert (see email-template-editor.js) — typing a placeholder by
               hand is the easiest thing to get wrong here, and a typo only surfaces as a Worker log
               warning after a real send. Rendered as buttons so they're keyboard-reachable. *@
            <div class="roster-list" style="margin-bottom:12px;">
                @foreach (var placeholder in VeSessionManager.Web.Pages.Admin.EmailTemplatesModel.PlaceholdersFor(template.Key))
                {
                    <button type="button" class="chip chip-neutral placeholder-chip" data-token="{{@placeholder}}"
                            title="Insert this placeholder">{{@placeholder}}</button>
                }
            </div>
            <form method="post" asp-page-handler="Update">
                <input type="hidden" name="templateId" value="@template.Id" />
                <input type="hidden" name="teamId" value="@Model.TeamId" />
                <div class="field"><label for="subject-@template.Id">Subject</label><input id="subject-@template.Id" name="subject" value="@template.Subject" required /></div>

                @* The textarea remains the field that posts, in both tabs — Quill is a second view
                   onto it, never a replacement. Without JS the page degrades to exactly what it was
                   before: a plain HTML textarea. *@
                <div class="field template-editor">
                    <label for="body-@template.Id">Body</label>
                    <div class="editor-tabs" role="tablist">
                        <button type="button" class="editor-tab" role="tab" data-mode="visual" aria-selected="true">Visual</button>
                        <button type="button" class="editor-tab" role="tab" data-mode="html" aria-selected="false">HTML</button>
                    </div>
                    <div class="editor-visual" data-editor-for="body-@template.Id">
                        <div class="editor-surface"></div>
                    </div>
                    <textarea id="body-@template.Id" name="body" rows="12" required>@template.Body</textarea>
                </div>

                <button type="submit" class="btn-primary btn-sm" style="margin-top:8px;">Save</button>
            </form>
        </div>
    }
}

@section Head {
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
}

@section Scripts {
    <script src="~/lib/quill/quill.js"></script>
    <script src="~/js/email-template-editor.js" asp-append-version="true"></script>
}
