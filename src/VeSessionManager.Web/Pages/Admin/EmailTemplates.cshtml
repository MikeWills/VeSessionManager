@page
@model VeSessionManager.Web.Pages.Admin.EmailTemplatesModel
@{
    ViewData["Title"] = "Email Templates";
    ViewData["ActiveNav"] = "AdminEmailTemplates";
    Layout = "_AppLayout";
}

@* The create form used to sit at the bottom of this page, on the reasoning that editing what is
   already here is the common case. With eleven shipped templates plus a team's own it is simply a
   long way down, and "somewhere past the fold" is not a discoverability strategy. Its own page, from
   a button that is always in the same place. *@
<div class="page-head">
    <div>
        <partial name="_ParentCrumb" model='new ParentCrumb("./Teams", "Teams", "Per team", RoleGroups.Admins)' />
        <h1>Email Templates</h1>
    </div>
    @if (Model.TeamId is not null)
    {
        <a class="btn-primary" asp-page="/Admin/EmailTemplateNew" asp-route-teamId="@Model.TeamId">+ New template</a>
    }
</div>

@if (Model.IsSystemAdmin)
{
    @* Same team-picker component as the session list, deliberately WITHOUT an "All teams" option:
       this page edits one team's configuration, so a merged view has no meaning. The trigger reads
       "Select a team…" until one is chosen, matching the prompt below. *@
    <form method="get" id="teamFilter" class="filters" style="margin-bottom:16px; align-items:flex-start;">
        <partial name="_TeamPicker" model="new VeSessionManager.Web.TeamPicker(Model.TeamId, Model.AvailableTeams, Model.TeamSummaryLabel, IncludeAllTeams: false)" />
    </form>
}

@if (Model.TeamId is null)
{
    <p>@(Model.IsSystemAdmin ? "Pick a team above." : "No team assigned to this account.")</p>
}
else
{
    @* A list, not eleven stacked editors (#395). Every template used to render its own trigger panel,
       placeholder chips, subject field and Quill editor on this one page — so finding the one you
       wanted meant scrolling past all the others, and the page grew with every template added. The
       editor moved to a page of its own; this answers "what have we got" and nothing else. *@
    @foreach (var group in Model.GroupedTemplates.Where(g => g.Templates.Count > 0))
    {
        <div class="template-phase">
            <h2>@group.Label</h2>
            <p class="session-sub">
                @group.Blurb
                @if (group.Label == "Sent automatically")
                {
                    <a asp-page="/Admin/MessageRules" asp-route-teamId="@Model.TeamId">Message Rules</a><text>.</text>
                }
            </p>
        </div>

        <div class="table-scroll" style="margin-bottom:24px;">
            <table class="cards">
                <thead>
                    <tr>
                        <th>Template</th>
                        <th>Sent</th>
                        <th>Last updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var template in group.Templates)
                    {
                        <tr>
                            <td>
                                <span class="session-title">@template.Label</span>
                                @if (template.IsUserDefined)
                                {
                                    <span class="chip chip-neutral">@(template.Audience == VeSessionManager.Core.Entities.EmailTemplateAudience.VolunteerExaminers ? "To VEs" : "To candidates")</span>
                                }
                                @if (VeSessionManager.Web.Pages.Admin.EmailTemplatesModel.IsRetired(template.Key))
                                {
                                    <span class="chip chip-brick">No longer sent</span>
                                }
                                @* A count as well as the chips opposite (#409): the chips answer "how
                                   many" when there are one or two, and stop answering it when you are
                                   scanning thirty rows for the one you changed. *@
                                @if (Model.RulesFor(template.Key).Count is var ruleCount && ruleCount > 0)
                                {
                                    <span class="chip chip-neutral">@ruleCount @(ruleCount == 1 ? "rule" : "rules")</span>
                                }
                                <div class="session-sub">@template.Subject</div>
                            </td>
                            <td>
                                @* Read off this team's rules, so it says what will actually happen
                                   rather than what the app's defaults once were — and each one links
                                   to its own editor, because "which rule sends this, and let me
                                   change it" is one question rather than two screens. *@
                                @foreach (var rule in Model.RulesFor(template.Key))
                                {
                                    <div>
                                        <a asp-page="/Admin/MessageRuleEdit" asp-route-id="@rule.Id"
                                           title="Edit the rule &quot;@rule.Name&quot;">
                                            <span class="chip @(rule.IsEnabled ? "chip-green" : "chip-neutral")">@rule.When</span>
                                        </a>
                                        <span class="session-sub">@rule.TriggerLabel@(rule.IsEnabled ? "" : " — switched off")</span>
                                    </div>
                                }
                                @if (VeSessionManager.Web.Pages.Admin.EmailTemplatesModel.TriggerFor(template.Key) is { } trigger)
                                {
                                    <span class="chip chip-neutral">By hand</span>
                                    <div class="session-sub">@trigger.Recipient</div>
                                }
                                else if (template.IsUserDefined)
                                {
                                    <span class="chip chip-neutral">By hand</span>
                                }

                                @* The way in to making this automatic, carrying the template with it
                                   (#409). It used to link at Message Rules with nothing but the team,
                                   so the next step was finding this same template again in a list of
                                   thirty — and it only appeared at zero rules, which left no path at
                                   all to a second one. Both fixed here.

                                   Withheld from a retired template (nothing sends it, so scheduling it
                                   is a trap) and from a VE one (a rule cannot send it at all — see
                                   MessageRuleAdminService.ValidateAsync). An affordance that leads
                                   straight to a refusal is worse than no affordance. *@
                                @* The "Add a rule…" link that used to sit here moved into the row menu
                                   (2026-08-21). It was the third destination for a row, living apart
                                   from the other two and labelled differently depending on whether any
                                   rule existed — so finding it meant knowing to look in a column about
                                   scheduling. One menu, one entry, whichever state the template is in. *@
                            </td>
                            <td data-sort-value="@(template.UpdatedUtc?.ToString("o") ?? "")">
                                @(template.UpdatedUtc is { } updated
                                    ? EasternTimeFormatter.Format(updated, "MMM d, yyyy")
                                    : "Not edited yet")
                            </td>
                            @* One kebab menu, matching Teams.cshtml and Vecs.cshtml — the row-action
                               pattern used across the admin tables. It was two bare icons (an eye and
                               a pencil) with the third action, Rules, living somewhere else entirely:
                               a link buried in the Sent column. Three destinations for one row, in two
                               different places, none of them labelled. A labelled menu says what each
                               one is, which is what an icon can only approximate.

                               Ordered look -> change -> schedule: View is the safest, Edit changes the
                               words, Rules changes when anybody gets them. *@
                            <td class="row-actions">
                                <button type="button" class="kebab" aria-label="Actions for @template.Label"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
                                <div class="menu">
                                    <a class="item" asp-page="/Admin/EmailTemplatePreview" asp-route-id="@template.Id">View</a>
                                    <a class="item" asp-page="/Admin/EmailTemplateEdit" asp-route-id="@template.Id">Edit</a>
                                    @* Rules goes where the answer is: to this template's rules when it
                                       has some, marked on arrival so the page opens on them rather than
                                       on a list to scan; to the add form, prefilled, when it has none.
                                       One entry either way — asking somebody to know which of two links
                                       applies is the confusion this replaces.

                                       Withheld for a retired or VE template for the same reason the old
                                       "Add a rule" link was: nothing sends a retired one, and a rule
                                       cannot send a VE one at all (MessageRuleAdminService.ValidateAsync
                                       refuses it). An affordance that leads straight to a refusal is
                                       worse than no affordance. *@
                                    @if (!VeSessionManager.Web.Pages.Admin.EmailTemplatesModel.IsRetired(template.Key)
                                         && template.Audience == VeSessionManager.Core.Entities.EmailTemplateAudience.Candidates)
                                    {
                                        @if (Model.RulesFor(template.Key).Count == 0)
                                        {
                                            <a class="item" asp-page="/Admin/MessageRuleNew" asp-route-teamId="@Model.TeamId"
                                               asp-route-templateId="@template.Id">Add a rule</a>
                                        }
                                        else
                                        {
                                            <a class="item" asp-page="/Admin/MessageRules" asp-route-teamId="@Model.TeamId"
                                               asp-route-highlightTemplate="@template.Key">Rules</a>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

}
