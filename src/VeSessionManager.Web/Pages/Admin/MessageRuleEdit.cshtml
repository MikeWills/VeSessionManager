@page "{id:int}"
@using VeSessionManager.Core.Messaging
@model VeSessionManager.Web.Pages.Admin.MessageRuleEditModel
@{
    ViewData["Title"] = "Edit Rule";
    ViewData["ActiveNav"] = "AdminMessageRules";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <partial name="_ParentCrumb" model='new ParentCrumb("./MessageRules", "Messages", "Per team", RoleGroups.Admins,
                 SafeReturnUrl.Or(Url, Model.ReturnUrl, Url.Page("/Admin/MessageRules", new { teamId = Model.Rule.TeamId })!))' />
        <h1>@Model.Rule.Name</h1>
        <p class="session-sub">@Model.TriggerLabel — @Model.TriggerBlurb</p>
    </div>
</div>

<div class="session-panel" style="display:block; max-width:640px;">
    <form method="post">
        <input type="hidden" asp-for="Id" />
        <div class="field">
            <label asp-for="Name">Name</label>
            <input asp-for="Name" required />
            <span class="session-sub">What the run log records. Only you see it.</span>
        </div>

        @if (Model.TakesParameter)
        {
            <div class="field" style="max-width:260px;">
                <label asp-for="ParameterDays">@Model.ParameterPrompt</label>
                <input asp-for="ParameterDays" type="number"
                       min="0.5"
                       max="@MessageDelay.Format(MessageDelay.Maximum)"
                       step="0.5" required />
                @* Days or hours (#116). The number field cannot express "1 hour" in days without
                   lying about it, so the unit moved rather than the precision. *@
                <select asp-for="ParameterUnit" class="filter-select">
                    <option value="@((int)MessageDelayUnit.Days)">days</option>
                    <option value="@((int)MessageDelayUnit.Hours)">hours</option>
                </select>
                @* A duration, not a date — the reason the column underneath is hours. *@
                <span class="session-sub">Whole or half days, or whole hours — 1 hour, 0.5 days is twelve hours, 5 days is five days.</span>
                @if (MessageTriggerLabels.ParameterCeilingNote(Model.Rule.Trigger) is { } ceiling)
                {
                    <span class="session-sub">@ceiling</span>
                }
            </div>
        }

        <div class="field" style="max-width:420px;">
            <span class="label-text">Send it as</span>
            @* ⚠️ checked is set explicitly. asp-for on a radio compares the MODEL value against
               the value attribute as strings, and an enum stringifies to its NAME — so "Email"
               never matches "0" and neither radio was ever marked. The form then showed no send
               method at all for a message that plainly had one (Mike, 2026-08-21). *@
            <label style="font-weight:400;">
                <input type="radio" asp-for="Channel" value="@((int)VeSessionManager.Core.Entities.MessageChannel.Email)"
                       checked="@(Model.Channel == VeSessionManager.Core.Entities.MessageChannel.Email)"
                       data-channel-radio="edit" />
                An email
            </label>
            <label style="font-weight:400;">
                <input type="radio" asp-for="Channel" value="@((int)VeSessionManager.Core.Entities.MessageChannel.Discord)"
                       checked="@(Model.Channel == VeSessionManager.Core.Entities.MessageChannel.Discord)"
                       data-channel-radio="edit" />
                A Discord post
            </label>
        </div>

        <div class="field" style="max-width:320px;" data-channel-only="Email" data-channel-group="edit"
             hidden="@(Model.Channel == VeSessionManager.Core.Entities.MessageChannel.Discord)">
            <label asp-for="Recipient">Who receives it</label>
            <select asp-for="Recipient" class="filter-select">
                @foreach (var recipient in Model.Definition.LegalRecipients)
                {
                    <option value="@((int)recipient)">@MessageTriggerLabels.Label(recipient)</option>
                }
            </select>
        </div>

        <div class="field" style="max-width:420px;" data-channel-only="Discord" data-channel-group="edit"
             hidden="@(Model.Channel != VeSessionManager.Core.Entities.MessageChannel.Discord)">
            <label asp-for="DiscordChannelId">Discord channel id</label>
            <input asp-for="DiscordChannelId" type="text" inputmode="numeric" />
            <span class="session-sub">
                Developer Mode on, right-click the channel, Copy Channel ID. The bot needs View Channel
                and Send Messages there.
            </span>
        </div>

        <div class="field" style="max-width:420px;" data-channel-only="Discord" data-channel-group="edit"
             hidden="@(Model.Channel != VeSessionManager.Core.Entities.MessageChannel.Discord)">
            <label asp-for="FanOut">How many posts</label>
            <select asp-for="FanOut" class="filter-select">
                <option value="@((int)VeSessionManager.Core.Entities.MessageFanOut.SingleDigest)">One post covering everybody</option>
                <option value="@((int)VeSessionManager.Core.Entities.MessageFanOut.PerRecipient)">One post each</option>
            </select>
            <span class="session-sub">
                A digest renders the template once with <code>{{Count}}</code> and <code>{{Subjects}}</code>;
                per-candidate tokens have no answer there and come out blank.
            </span>
        </div>

        @* The message itself, authored here against its own trigger — which is what lets the tag
           list beside it be correct. A template authored somewhere else could not say which tags
           applied, because it had no trigger. *@
        <div class="field" style="max-width:640px;">
            <label asp-for="Subject">Subject</label>
            <input asp-for="Subject" data-token-target="subject" required />
        </div>

        <div class="field" style="max-width:640px;">
            <label for="body">Message</label>
            @* The textarea remains the field that posts, in both tabs — Quill is a second view onto
               it, never a replacement. Without JS the page degrades to a plain textarea, which is
               exactly what this was before the editor moved here from the Email Templates page. *@
            <div class="message-editor">
                <div class="editor-tabs" role="tablist">
                    <button type="button" class="editor-tab" role="tab" data-mode="visual" aria-selected="true">Visual</button>
                    <button type="button" class="editor-tab" role="tab" data-mode="html" aria-selected="false">HTML</button>
                </div>
                <div class="editor-visual" data-editor-for="body">
                    <div class="editor-surface"></div>
                </div>
                <textarea id="body" asp-for="Body" data-token-target="body" rows="12" required></textarea>
            </div>

            @* Click to insert, rather than a list to retype. A hand-typed {{CandidateFirstName}} that
               is a letter out renders blank, and nothing anywhere says it went wrong — the send just
               succeeds with a hole in it. The tags shown are this trigger's own, which is the whole
               reason the message is authored here. *@
            <div class="token-chips">
                <span class="session-sub">Click to add:</span>
                @foreach (var token in MessageTriggerDefinitions.For(Model.Rule.Trigger).Placeholders)
                {
                    <button type="button" class="token-chip" data-insert-token="@("{{" + token + "}}")">@("{{" + token + "}}")</button>
                }
            </div>
        </div>

        @* Email only, and hidden with the rest of the email fields when the rule posts to Discord:
           nobody is addressed on a channel post, so there is nothing to reply to and nobody to copy. *@
        <div data-channel-only="Email" data-channel-group="edit"
             hidden="@(Model.Channel == VeSessionManager.Core.Entities.MessageChannel.Discord)">
            <h2 style="margin-top:24px;">Replies and copies</h2>

            <div class="field" style="max-width:420px;">
                <label asp-for="ReplyToSource">Replies go to</label>
                <select asp-for="ReplyToSource" class="filter-select" data-reply-to-source data-custom-value="@((int)VeSessionManager.Core.Entities.MessageReplyToSource.Custom)">
                    <option value="@((int)VeSessionManager.Core.Entities.MessageReplyToSource.EmailSettings)">Your team's reply-to address</option>
                    <option value="@((int)VeSessionManager.Core.Entities.MessageReplyToSource.SessionLead)">The session's lead VE</option>
                    <option value="@((int)VeSessionManager.Core.Entities.MessageReplyToSource.Custom)">A specific address</option>
                </select>
                @* One caption per option, each shown with its own.

                   There used to be a single caption describing the session-lead fallback, on screen
                   whichever option was chosen — so it was wrong two thirds of the time, and read as
                   an instruction about the selection somebody had actually made. Mike, looking at the
                   form: "the messaging doesn't align with the dropdowns very well."

                   Server-renders the initial state and app.js swaps them on change, the same shape as
                   the address box below. Without JavaScript all three show, which is wordy rather
                   than wrong. *@
                <span class="session-sub" data-reply-to-hint="@((int)VeSessionManager.Core.Entities.MessageReplyToSource.EmailSettings)"
                      hidden="@(Model.ReplyToSource != VeSessionManager.Core.Entities.MessageReplyToSource.EmailSettings)">
                    @if (Model.TeamReplyToAddress is { Length: > 0 } teamAddress)
                    {
                        <text>Replies go to <strong>@teamAddress</strong>, from this team's email settings.</text>
                    }
                    else
                    {
                        <text>This team has no reply-to address set yet — set one in Team Settings, or replies will go nowhere useful.</text>
                    }
                </span>
                @* The fallback is silent by design — a reply reaching the team beats one reaching
                   nobody — but somebody should know it can happen. *@
                <span class="session-sub" data-reply-to-hint="@((int)VeSessionManager.Core.Entities.MessageReplyToSource.SessionLead)"
                      hidden="@(Model.ReplyToSource != VeSessionManager.Core.Entities.MessageReplyToSource.SessionLead)">
                    Replies go to whoever led the session. If that cannot be worked out — no call sign on
                    the session, or no VE record with an email — they go to your team's address instead.
                </span>
                <span class="session-sub" data-reply-to-hint="@((int)VeSessionManager.Core.Entities.MessageReplyToSource.Custom)"
                      hidden="@(Model.ReplyToSource != VeSessionManager.Core.Entities.MessageReplyToSource.Custom)">
                    Replies go to the address below, whoever the message is about.
                </span>
            </div>

            @* Only meaningful with "a specific address" chosen, so it is not shown otherwise —
               a box captioned "used only with the option you did not pick" is a question the
               form should not be asking (Mike, 2026-08-21).

               Initial state is server-rendered and app.js handles the change, matching the
               channel fields above. Hidden rather than removed: with JavaScript unavailable
               every field is simply visible, which is a cluttered form rather than a broken
               one, and the server ignores a stray value either way. *@
            <div class="field" style="max-width:420px;" id="replyToOverrideField"
                 hidden="@(Model.ReplyToSource != VeSessionManager.Core.Entities.MessageReplyToSource.Custom)">
                <label asp-for="ReplyToOverride">Reply-to address</label>
                <input asp-for="ReplyToOverride" type="email" />
                <span class="session-sub">Where replies to this message go.</span>
            </div>

            @* From is deliberately absent. Changing it means SPF/DKIM/DMARC on a domain this app does
               not control, and getting it wrong sends the mail to spam silently — Reply-To is the
               field that actually answers "can it come from the session lead". *@
            @* Plain words, one short hint each. These read "Blind copy each message to" / "Visible
               copy to" / "Send those copies once per run, not once per recipient", each under a
               paragraph of reasoning — and Mike, who built the app, could not read his own form
               (2026-08-21). Cc and Bcc are what everyone already knows; "run" is a word from inside
               the code. The reasoning stays here in the comments, where it belongs. *@
            <div class="field" style="max-width:420px;">
                <label asp-for="BccAddress">Bcc</label>
                <input asp-for="BccAddress" type="email" />
                <span class="session-sub">A hidden copy. The recipient does not see this address.</span>
            </div>

            @* Allowed on candidate-facing rules too (reversed 2026-08-25, Mike: "I want to CC my email
               ... so they can see that I know") — the visibility is the point for some teams, not a
               mistake to guard against. Still can't unsubscribe from it, which is why the hint says so
               rather than staying silent. *@
            <div class="field" style="max-width:420px;">
                <label asp-for="CcAddress">Cc</label>
                <input asp-for="CcAddress" type="email" />
                <span class="session-sub">A visible copy. The recipient sees this address and cannot unsubscribe from it.</span>
            </div>

            @* Without this, a forty-candidate session puts forty identical copies in one inbox, which
               is the point somebody filters the folder and stops looking. *@
            <div class="field">
                <label style="font-weight:400;">
                    <input asp-for="MonitoringCopyOncePerRun" type="checkbox" />
                    Only send one copy, even when the message goes to many people
                </label>
                <span class="session-sub">Recommended.</span>
            </div>
        </div>

        <button type="submit" class="btn-primary btn-sm">Save</button>
    </form>
</div>

@* Stated where the change is made, because both are surprising in the same direction — an edit does
   less than it looks like it does, which is the safe direction and the one worth saying out loud. *@
<p class="session-sub" style="max-width:640px; margin-top:16px;">
    Changing the delay does not re-open anybody already sent to: widening a one-day reminder to two
    reaches people not yet reminded, never people who already were. And this rule still never fires for
    anyone whose moment passed before it was created.
</p>

@section Scripts {
    <script src="~/lib/quill/quill.js"></script>
    <script src="~/js/message-editor.js" asp-append-version="true"></script>
}
@section Head {
    <link rel="stylesheet" href="~/lib/quill/quill.snow.css" />
}
