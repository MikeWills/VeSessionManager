@page
@using VeSessionManager.Core.Entities
@using VeSessionManager.Core.Messaging
@model VeSessionManager.Web.Pages.Admin.MessageRulesModel
@{
    ViewData["Title"] = "Messages";
    ViewData["ActiveNav"] = "AdminMessageRules";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <partial name="_ParentCrumb" model='new ParentCrumb("./Teams", "Teams", "Per team", RoleGroups.Admins)' />
        <h1>Messages</h1>
        <p class="session-sub">
            Every email and Discord post this team can send. Each moment below can carry any number of
            messages — or none, in which case nothing is sent at that moment.
        </p>
    </div>
</div>

@if (Model.IsSystemAdmin)
{
    @* Deliberately without an "All teams" option: this edits one team's configuration, so a merged
       view has no meaning. *@
    <form method="get" id="teamFilter" class="filters" style="margin-bottom:16px; align-items:flex-start;">
        <partial name="_TeamPicker" model="new VeSessionManager.Web.TeamPicker(Model.TeamId, Model.AvailableTeams, Model.TeamSummaryLabel, IncludeAllTeams: false)" />
    </form>
}

@if (Model.TeamId is null)
{
    <p>@(Model.IsSystemAdmin ? "Pick a team above." : "No team assigned to this account.")</p>
}
else
{
    @* Two groups, because the columns differ. A hand-sent message has no delay and no fixed
       recipient — somebody chose the moment and picks the people at send time — and a blank "When"
       sitting in a column of real ones reads as a bug rather than as "not applicable". *@
    var sentAutomatically = Model.Sections.Where(s => !s.IsSentByHand).ToList();
    var sentByHand = Model.Sections.Where(s => s.IsSentByHand).ToList();

    <h2 class="section-title">Sent automatically</h2>
    @foreach (var point in sentAutomatically)
    {
        <partial name="_MessageTriggerSection" model="point" />
    }

    <h2 class="section-title">Sent by hand</h2>
    <p class="session-sub">
        These are the messages offered when somebody composes an email from a session or from the VE
        directory. Nothing sends them on its own. Switching one off takes it off that list.
    </p>
    @foreach (var point in sentByHand)
    {
        <partial name="_MessageTriggerSection" model="point" />
    }

    <p class="session-sub">
        A new message never goes to anyone whose moment has already passed — add a seven-day reminder
        today and nobody already inside seven days of their session hears from it. Switching a message
        off stops it immediately and queues nothing; switching it back on picks up from that moment. A
        deleted message is gone for good, and a moment with no messages simply sends nothing.
    </p>
}
