@page
@model VeSessionManager.Web.Pages.Admin.SystemSettingsModel
@{
    ViewData["Title"] = "System Settings";
    ViewData["ActiveNav"] = "AdminSystemSettings";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Deployment-wide</p>
        <h1>System Settings</h1>
    </div>
</div>

<div class="session-panel" style="display:block;">
    <div class="section-head"><h2>PII Retention</h2></div>
    <form method="post">
        <div class="field" style="max-width:280px;">
            <label for="piiRetentionWindowDays">Retention window (days)</label>
            <input id="piiRetentionWindowDays" name="piiRetentionWindowDays" type="number" min="1" value="@Model.PiiRetentionWindowDays" placeholder="Not yet set" />
        </div>
        <p class="session-sub">Used by the PII purge job. Leave blank until an explicit value is decided — no default is assumed.</p>

        <div class="section-head" style="margin-top:24px;"><h2>ULS Polling</h2></div>
        <div class="meta-grid">
            <div class="field" style="max-width:200px;">
                <label for="ulsWatcherStartHourEt">First check of the day (ET, 0-23)</label>
                <input id="ulsWatcherStartHourEt" name="ulsWatcherStartHourEt" type="number" min="0" max="23" value="@Model.UlsWatcherStartHourEt" required />
            </div>
            <div class="field" style="max-width:200px;">
                <label for="ulsWatcherIntervalHours">Check interval (hours)</label>
                <input id="ulsWatcherIntervalHours" name="ulsWatcherIntervalHours" type="number" min="1" value="@Model.UlsWatcherIntervalHours" required />
            </div>
        </div>
        <p class="session-sub">Checks at the start hour (US Eastern) and again every interval after that — e.g. 8 + 12 checks at 8am and 8pm ET. FCC issues licences at 2am ET Tue&ndash;Sat, so a morning check lands after that day's grants exist. Each check looks up only candidates still awaiting a grant, so it costs one request per pending applicant. <strong>These two values also drive the Renewal Monitor refresh</strong>, which reads the same FCC data through the same mirror and so runs on the same schedule.</p>

        <div class="section-head" style="margin-top:24px;"><h2>Session Ingestion</h2></div>
        <div class="field" style="max-width:280px;">
            <label for="sessionIngestionIntervalMinutes">Normal polling interval (minutes)</label>
            <input id="sessionIngestionIntervalMinutes" name="sessionIngestionIntervalMinutes" type="number" min="1" value="@Model.SessionIngestionIntervalMinutes" required />
        </div>
        <p class="session-sub">How often each team's ExamTools poll (+ Zoom/Discord/Square/email follow-up) runs. This is the cadence for every team, flat — the job itself wakes more often than this, but only polls a team once this interval has elapsed since that team's last run. To pull in a last-minute registrant right now, use <strong>Refresh candidates</strong> on the session, which does not wait for the schedule.</p>

        <div class="section-head" style="margin-top:24px;"><h2>Test Mode</h2></div>
        <div class="field" style="max-width:400px; flex-direction:row; align-items:center; gap:8px;">
            <input id="testModeEnabled" name="testModeEnabled" type="checkbox" value="true" checked="@Model.TestModeEnabled" style="width:auto;" />
            <input name="testModeEnabled" type="hidden" value="false" />
            <label for="testModeEnabled" style="margin:0;">Test mode is on — redirect every outgoing email</label>
        </div>
        <div class="field" style="max-width:400px; margin-top:8px;">
            <label for="testModeOverrideEmail">Override email address</label>
            <input id="testModeOverrideEmail" name="testModeOverrideEmail" type="email" value="@Model.TestModeOverrideEmail" placeholder="you@example.com" />
        </div>
        <p class="session-sub">While on, every email this app would send (registration confirmations, reminders, disclosure/youth-program instructions, payment expiration notices — everything, for every team) goes to this one address instead of the real recipient, with the original recipient noted in the email itself. Use this to run a session through the full pipeline with real ExamTools data without emailing anyone for real. A red bar appears across every page while this is on.</p>

        @if (Model.UpdatedUtc is not null)
        {
            <p class="session-sub" style="margin-top:16px;">Last updated @EasternTimeFormatter.Format(Model.UpdatedUtc.Value, "MMM d, yyyy h:mm tt")</p>
        }

        <div class="panel-actions" style="align-items:flex-start; margin-top:20px;">
            <button type="submit" class="btn-primary">Save settings</button>
        </div>
    </form>
</div>

<div class="session-panel" style="display:block; margin-top:24px;">
    <div class="section-head">
        <h2>System Email</h2>
        @if (Model.IsSystemEmailConfigured)
        {
            <span class="chip chip-green">Configured</span>
        }
        else
        {
            <span class="chip chip-neutral">Not configured</span>
        }
    </div>
    <p class="session-sub">
        The deployment-wide sender for email addressed to <em>app users</em> rather than candidates —
        today that means password reset links. Candidate email (confirmations, reminders, payment
        notices) is unaffected and still sends from each team's own SMTP settings. A password reset
        can't be sent at all until this is filled in, because a system administrator may not belong to
        any team. Test mode, above, redirects these emails too.
    </p>
    <form method="post" asp-page-handler="SystemEmail">
        <div class="field" style="max-width:400px;">
            <label for="systemSmtpHost">SMTP host</label>
            <input id="systemSmtpHost" name="systemSmtpHost" value="@Model.SystemSmtpHost" placeholder="smtp.mailgun.org" />
        </div>
        <div class="field" style="max-width:200px;">
            <label for="systemSmtpPort">Port</label>
            <input id="systemSmtpPort" name="systemSmtpPort" type="number" min="1" max="65535" value="@Model.SystemSmtpPort" placeholder="587" />
        </div>
        <div class="field" style="max-width:400px;">
            <label for="systemSmtpUsername">Username</label>
            <input id="systemSmtpUsername" name="systemSmtpUsername" value="@Model.SystemSmtpUsername" autocomplete="off" />
        </div>
        <div class="field" style="max-width:400px;">
            <label for="systemSmtpPassword">Password</label>
            @* Never rendered back — an empty box means "keep the stored secret". *@
            <input id="systemSmtpPassword" name="systemSmtpPassword" type="password" autocomplete="new-password"
                   placeholder="@(Model.SystemSmtpPasswordIsSet ? "Stored — leave blank to keep" : "")" />
        </div>
        <div class="field" style="max-width:400px; flex-direction:row; align-items:center; gap:8px;">
            <input id="systemSmtpUseStartTls" name="systemSmtpUseStartTls" type="checkbox" value="true" checked="@Model.SystemSmtpUseStartTls" style="width:auto;" />
            <input name="systemSmtpUseStartTls" type="hidden" value="false" />
            <label for="systemSmtpUseStartTls" style="margin:0;">Use StartTLS</label>
        </div>
        <div class="field" style="max-width:400px;">
            <label for="systemSmtpFromAddress">From address</label>
            <input id="systemSmtpFromAddress" name="systemSmtpFromAddress" type="email" value="@Model.SystemSmtpFromAddress" placeholder="Defaults to the username" />
        </div>
        <div class="field" style="max-width:400px;">
            <label for="systemSmtpFromDisplayName">From display name</label>
            <input id="systemSmtpFromDisplayName" name="systemSmtpFromDisplayName" value="@Model.SystemSmtpFromDisplayName" placeholder="VE Session Manager" />
        </div>
        <div class="panel-actions" style="align-items:flex-start; margin-top:20px;">
            <button type="submit" class="btn-primary">Save email settings</button>
        </div>
    </form>
</div>
