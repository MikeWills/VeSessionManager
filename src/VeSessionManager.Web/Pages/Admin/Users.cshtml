@page
@model VeSessionManager.Web.Pages.Admin.UsersModel
@using VeSessionManager.Core.Entities
@{
    ViewData["Title"] = "Users";
    ViewData["ActiveNav"] = "AdminUsers";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">@(Model.IsSystemAdmin ? "Deployment-wide" : "Your team")</p>
        <h1>Users</h1>
    </div>
    @if (Model.IsSystemAdmin || Model.TeamId is not null)
    {
        <button type="button" class="btn-primary" data-open-modal="createUserModal">+ New User</button>
    }
</div>

@* Same team-picker component as the session list. "All teams" is kept — this page already
   supported an unfiltered view, it was just drawn as pills. *@
@if (Model.IsSystemAdmin)
{
    <form method="get" id="userFilters" class="filters" style="margin-bottom:16px; align-items:flex-start;">
        <div class="filter-dropdown">
            <button type="button" class="kebab @(Model.TeamId is not null ? "active" : "")">Team: @Model.TeamSummaryLabel <i class="bi bi-caret-down-fill" aria-hidden="true"></i></button>
            <div class="menu">
                <label class="item"><input type="radio" name="teamId" value="" @(Model.TeamId is null ? "checked" : "") /> All teams</label>
                @foreach (var team in Model.AvailableTeams)
                {
                    <label class="item"><input type="radio" name="teamId" value="@team.Id" @(team.Id == Model.TeamId ? "checked" : "") /> @team.Name</label>
                }
                <hr />
                <button type="submit" class="item">Apply</button>
            </div>
        </div>
    </form>
}

@if (!Model.IsSystemAdmin && Model.TeamId is null)
{
    <p>No team assigned to this account.</p>
}
else
{
    <div class="table-scroll">
    <table class="cards" data-sortable="users">
        <thead>
            <tr>
                <th>Name</th>
                <th>Call sign</th>
                <th>Email</th>
                <th>Role</th>
                <th>Team</th>
                <th>Manager</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Users.Count == 0)
            {
                <tr><td colspan="8">No users yet.</td></tr>
            }
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td class="session-title">@u.Name</td>
                    <td class="mono">@(u.CallSign ?? "—")</td>
                    <td class="mono">@u.Email</td>
                    <td>@u.Role</td>
                    <td>@(string.IsNullOrEmpty(u.TeamNames) ? "—" : u.TeamNames)</td>
                    <td>@(u.ManagerName ?? "—")</td>
                    <td>
                        @if (u.IsActive)
                        {
                            <span class="chip chip-green">Active</span>
                        }
                        else
                        {
                            <span class="chip chip-brick">Deactivated</span>
                        }
                    </td>
                    <td class="row-actions">
                        <button type="button" class="kebab" aria-label="Actions"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
                        <div class="menu">
                            <button type="button" class="item" data-open-modal="callSignModal-@u.Id">Set call sign</button>
                            <button type="button" class="item" data-open-modal="roleModal-@u.Id">Change role</button>
                            @if (u.Role is UserRole.TeamAdmin or UserRole.SessionManager)
                            {
                                <button type="button" class="item" data-open-modal="teamsModal-@u.Id">Manage teams</button>
                            }
                            @if (u.Role == UserRole.TeamLead)
                            {
                                <button type="button" class="item" data-open-modal="managerModal-@u.Id">Assign manager</button>
                            }
                            <hr>
                            @if (u.IsActive)
                            {
                                <form method="post" asp-page-handler="Deactivate">
                                    <input type="hidden" name="targetUserId" value="@u.Id" />
                                    <button type="submit" class="item danger" disabled="@(u.Id == Model.CurrentUserId)">Deactivate</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Reactivate">
                                    <input type="hidden" name="targetUserId" value="@u.Id" />
                                    <button type="submit" class="item">Reactivate</button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <div class="modal-backdrop" id="createUserModal">
        <div class="modal">
            <h3>New User</h3>
            <form method="post" asp-page-handler="Create">
                <div class="field"><label for="createUserEmail">Email</label><input id="createUserEmail" name="email" type="email" required /></div>
                <div class="field"><label for="createUserName">Name</label><input id="createUserName" name="name" required /></div>
                <div class="field"><label for="createUserCallSign">Call sign</label><input id="createUserCallSign" name="callSign" placeholder="Optional" /></div>
                <div class="field">
                    <label for="createUserRole">Role</label>
                    <select id="createUserRole" name="role">
                        @foreach (var role in Model.AssignableRoles)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </div>
                <div class="field"><label for="createUserPassword">Initial password</label><input id="createUserPassword" name="password" type="password" required /></div>
                <p class="session-sub">New TeamAdmin/SessionManager accounts start with no team assigned — use "Manage teams" after creating to grant access.</p>
                <div class="modal-actions">
                    <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                    <button type="submit" class="btn-primary btn-sm">Create</button>
                </div>
            </form>
        </div>
    </div>

    @foreach (var u in Model.Users)
    {
        <div class="modal-backdrop" id="callSignModal-@u.Id">
            <div class="modal">
                <h3>Set call sign — @u.Name</h3>
                <form method="post" asp-page-handler="SetCallSign">
                    <input type="hidden" name="targetUserId" value="@u.Id" />
                    <div class="field">
                        <label for="callSign-@u.Id">Call sign</label>
                        <input id="callSign-@u.Id" name="callSign" value="@u.CallSign" placeholder="Optional" />
                    </div>
                    <p class="session-sub">Stored in upper case. Leave blank to clear it.</p>
                    <div class="modal-actions">
                        <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                        <button type="submit" class="btn-primary btn-sm">Save</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="modal-backdrop" id="roleModal-@u.Id">
            <div class="modal">
                <h3>Change role — @u.Name</h3>
                <form method="post" asp-page-handler="SetRole">
                    <input type="hidden" name="targetUserId" value="@u.Id" />
                    <div class="field">
                        <label for="newRole-@u.Id">Role</label>
                        <select id="newRole-@u.Id" name="newRole">
                            @foreach (var role in Model.AssignableRoles)
                            {
                                <option value="@role" selected="@(role == u.Role)">@role</option>
                            }
                        </select>
                    </div>
                    <div class="modal-actions">
                        <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                        <button type="submit" class="btn-primary btn-sm">Save</button>
                    </div>
                </form>
            </div>
        </div>

        @if (u.Role is UserRole.TeamAdmin or UserRole.SessionManager)
        {
            <div class="modal-backdrop" id="teamsModal-@u.Id">
                <div class="modal">
                    <h3>Manage teams — @u.Name</h3>
                    <form method="post" asp-page-handler="SetTeams">
                        <input type="hidden" name="targetUserId" value="@u.Id" />
                        @foreach (var team in Model.AvailableTeams)
                        {
                            <div class="field">
                                <label>
                                    <input type="checkbox" name="teamIds" value="@team.Id" checked="@(u.TeamIds.Contains(team.Id))" style="width:auto; display:inline-block;" />
                                    @team.Name
                                </label>
                            </div>
                        }
                        <div class="modal-actions">
                            <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                            <button type="submit" class="btn-primary btn-sm">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @if (u.Role == UserRole.TeamLead)
        {
            <div class="modal-backdrop" id="managerModal-@u.Id">
                <div class="modal">
                    <h3>Assign manager — @u.Name</h3>
                    <form method="post" asp-page-handler="SetManager">
                        <input type="hidden" name="targetUserId" value="@u.Id" />
                        <div class="field">
                            <label for="managerUserId-@u.Id">Manager</label>
                            <select id="managerUserId-@u.Id" name="managerUserId">
                                <option value="">(none)</option>
                                @foreach (var manager in Model.AvailableManagers)
                                {
                                    <option value="@manager.Id" selected="@(manager.Name == u.ManagerName)">@manager.Name</option>
                                }
                            </select>
                        </div>
                        <div class="modal-actions">
                            <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                            <button type="submit" class="btn-primary btn-sm">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    }
}
