@page
@model VeSessionManager.Web.Pages.Admin.FeeConfigurationsModel
@{
    ViewData["Title"] = "Fee Configurations";
    ViewData["ActiveNav"] = "AdminFees";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Per VEC</p>
        <h1>Fee Configurations</h1>
    </div>
    @if (Model.VecId is not null)
    {
        <button type="button" class="btn-primary" data-open-modal="createFeeModal">+ New fee configuration</button>
    }
</div>

@if (Model.AvailableVecs.Count == 0)
{
    <p>No VECs available.</p>
}
else
{
    <div class="filters" style="margin-bottom:16px;">
        @foreach (var vec in Model.AvailableVecs)
        {
            <a class="filter-pill @(vec.Id == Model.VecId ? "active" : "")" asp-page="./FeeConfigurations" asp-route-vecId="@vec.Id">@vec.Name</a>
        }
    </div>

    <div class="table-scroll">
    <table class="cards" data-sortable="fee-configurations">
        <thead>
            <tr>
                <th>Effective</th>
                <th>Fee collection</th>
                <th>Regular fee</th>
                <th>Youth fee</th>
                <th>Retained</th>
                <th>Notes</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.FeeConfigurations.Count == 0)
            {
                <tr><td colspan="7">No fee configurations for this VEC yet.</td></tr>
            }
            @foreach (var fc in Model.FeeConfigurations)
            {
                <tr>
                    <td data-sort-value="@fc.EffectiveDate.ToString("yyyy-MM-dd")">@fc.EffectiveDate.ToString("MMM d, yyyy")</td>
                    <td>
                        @if (fc.FeeCollectionEnabled)
                        {
                            <span class="chip chip-green">Enabled</span>
                        }
                        else
                        {
                            <span class="chip chip-neutral">Disabled</span>
                        }
                    </td>
                    <td>@(fc.ExamFeeAmount is null ? "—" : $"${fc.ExamFeeAmount:F2}")</td>
                    <td>@(fc.YouthExamFeeAmount is null ? "—" : $"${fc.YouthExamFeeAmount:F2}")</td>
                    <td>@(fc.RetainedAmount is null ? "—" : $"${fc.RetainedAmount:F2}")</td>
                    <td>@fc.Notes</td>
                    <td class="row-actions">
                        @if (fc.InUse)
                        {
                            <span class="session-sub">In use — create a new row to change</span>
                        }
                        else
                        {
                            <button type="button" class="btn-secondary btn-sm" data-open-modal="editFeeModal-@fc.Id">Edit</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <div class="modal-backdrop" id="createFeeModal">
        <div class="modal">
            <h3>New fee configuration</h3>
            <form method="post" asp-page-handler="Create">
                <input type="hidden" name="vecId" value="@Model.VecId" />
                <div class="field"><label for="createFeeEffectiveDate">Effective date</label><input id="createFeeEffectiveDate" name="effectiveDate" type="date" required /></div>
                <div class="field">
                    <label><input type="checkbox" name="feeCollectionEnabled" value="true" checked style="width:auto; display:inline-block;" /> Fee collection enabled</label>
                </div>
                <div class="field"><label for="createFeeExamAmount">Regular fee</label><input id="createFeeExamAmount" name="examFeeAmount" type="number" step="0.01" min="0" /></div>
                <div class="field"><label for="createFeeYouthAmount">Youth fee</label><input id="createFeeYouthAmount" name="youthExamFeeAmount" type="number" step="0.01" min="0" /></div>
                <div class="field"><label for="createFeeRetainedAmount">Retained amount</label><input id="createFeeRetainedAmount" name="retainedAmount" type="number" step="0.01" min="0" /></div>
                <div class="field"><label for="createFeeNotes">Notes</label><textarea id="createFeeNotes" name="notes" rows="2"></textarea></div>
                <div class="modal-actions">
                    <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                    <button type="submit" class="btn-primary btn-sm">Create</button>
                </div>
            </form>
        </div>
    </div>

    @foreach (var fc in Model.FeeConfigurations.Where(f => !f.InUse))
    {
        <div class="modal-backdrop" id="editFeeModal-@fc.Id">
            <div class="modal">
                <h3>Edit fee configuration</h3>
                <form method="post" asp-page-handler="Update">
                    <input type="hidden" name="feeConfigurationId" value="@fc.Id" />
                    <div class="field"><label for="editFeeEffectiveDate-@fc.Id">Effective date</label><input id="editFeeEffectiveDate-@fc.Id" name="effectiveDate" type="date" value="@fc.EffectiveDate.ToString("yyyy-MM-dd")" required /></div>
                    <div class="field">
                        <label><input type="checkbox" name="feeCollectionEnabled" value="true" checked="@fc.FeeCollectionEnabled" style="width:auto; display:inline-block;" /> Fee collection enabled</label>
                    </div>
                    <div class="field"><label for="editFeeExamAmount-@fc.Id">Regular fee</label><input id="editFeeExamAmount-@fc.Id" name="examFeeAmount" type="number" step="0.01" min="0" value="@fc.ExamFeeAmount" /></div>
                    <div class="field"><label for="editFeeYouthAmount-@fc.Id">Youth fee</label><input id="editFeeYouthAmount-@fc.Id" name="youthExamFeeAmount" type="number" step="0.01" min="0" value="@fc.YouthExamFeeAmount" /></div>
                    <div class="field"><label for="editFeeRetainedAmount-@fc.Id">Retained amount</label><input id="editFeeRetainedAmount-@fc.Id" name="retainedAmount" type="number" step="0.01" min="0" value="@fc.RetainedAmount" /></div>
                    <div class="field"><label for="editFeeNotes-@fc.Id">Notes</label><textarea id="editFeeNotes-@fc.Id" name="notes" rows="2">@fc.Notes</textarea></div>
                    <div class="modal-actions">
                        <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                        <button type="submit" class="btn-primary btn-sm">Save</button>
                    </div>
                </form>
            </div>
        </div>
    }
}
