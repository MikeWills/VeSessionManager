@page
@model VeSessionManager.Web.Pages.Admin.TeamsModel
@{
    ViewData["Title"] = "Teams";
    ViewData["ActiveNav"] = "AdminTeams";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">@(Model.CanCreateTeam ? "Deployment-wide" : "Your teams")</p>
        <h1>Teams</h1>
    </div>
    @* Hidden for a TeamAdmin, who can view this list but not add to it. The handler forbids it too —
       hiding a button is presentation, not authorization. *@
    @if (Model.CanCreateTeam)
    {
        <button type="button" class="btn-primary" data-open-modal="createTeamModal">+ New Team</button>
    }
</div>

<div class="table-scroll">
<table class="cards" data-sortable="teams">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Created</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Teams.Count == 0)
        {
            <tr><td colspan="4">No teams yet.</td></tr>
        }
        @foreach (var team in Model.Teams)
        {
            <tr>
                <td class="count">@team.Id</td>
                <td class="session-title">
                    @team.Name
                    @* A muted team's data is indistinguishable from real data, which is the whole
                       risk of #64 — so say so wherever the team is named. *@
                    @if (team.MutedIntegrations.Count > 0)
                    {
                        <span class="chip chip-brick" title="Outbound calls suppressed for this team">Muted: @string.Join(", ", team.MutedIntegrations)</span>
                    }
                    @* Deactivated teams stay on this list on purpose — it is not a soft delete, and
                       reactivating or deleting are the only two actions left for one. *@
                    @if (!team.IsActive)
                    {
                        <span class="chip chip-brick" title="Deactivated @EasternTimeFormatter.Format(team.DeactivatedUtc!.Value, "MMM d, yyyy") — the app does not poll or send for this team">Inactive</span>
                    }
                </td>
                <td data-sort-value="@team.CreatedUtc.ToString("o")">@EasternTimeFormatter.Format(team.CreatedUtc, "MMM d, yyyy")</td>
                @* One kebab menu, matching Vecs.cshtml — the row-action pattern used across the
                   admin tables. It was two bare icon links until 2026-08-06; a third entry made the
                   icons ambiguous (an envelope for "email templates" reads as "send something"), and
                   a labelled menu says what each one is.

                   Everything per-team lives here, so this row is the one stop for a team's
                   configuration: credentials and settings, its people, its own email templates, and
                   the maintenance/refresh actions. Every one of those pages already takes a teamId,
                   so arriving from here skips the team picker you would otherwise have to re-answer
                   with the team already in front of you — no page changes were needed to add them,
                   only the links.

                   Ordered configure -> people -> content -> act, with Maintenance last because it
                   is the only entry that *does* something rather than showing something. *@
                <td class="row-actions">
                    <button type="button" class="kebab" aria-label="Actions for @team.Name"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
                    <div class="menu">
                        <a class="item" asp-page="./TeamSettings" asp-route-teamId="@team.Id">Settings</a>
                        <a class="item" asp-page="./Users" asp-route-teamId="@team.Id">Users</a>
                        <a class="item" asp-page="./MessageRules" asp-route-teamId="@team.Id">Messages</a>
                        <a class="item" asp-page="./TeamMaintenance" asp-route-teamId="@team.Id">Maintenance</a>
                        @* Last, and separated, because it is the only entry that changes whether the
                           app acts for this team at all rather than showing or configuring something. *@
                        <form method="post" asp-page-handler="SetActive" asp-antiforgery="true">
                            <input type="hidden" name="teamId" value="@team.Id" />
                            <input type="hidden" name="active" value="@((!team.IsActive).ToString().ToLowerInvariant())" />
                            <button type="submit" class="item @(team.IsActive ? "danger" : "")">
                                @(team.IsActive ? "Deactivate" : "Reactivate")
                            </button>
                        </form>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<div class="modal-backdrop" id="createTeamModal">
    <div class="modal">
        <h3>New Team</h3>
        <form method="post" asp-page-handler="Create">
            <div class="field"><label for="createTeamName">Name</label><input id="createTeamName" name="name" required /></div>
            <div class="modal-actions">
                <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                <button type="submit" class="btn-primary btn-sm">Create</button>
            </div>
        </form>
    </div>
</div>
