@page
@using VeSessionManager.Core.Entities
@model VeSessionManager.Web.Pages.VeSelfService.DetailsModel
@{
    ViewData["Title"] = "Your VE details";
    Layout = "_PublicLayout";
}

<div class="ve-panel">
    <h1>Your details</h1>
    <p class="session-sub">
        @Model.Person.Name@(Model.Person.CallSign is { } call ? $" — {call}" : "")@(Model.Teams.Count > 0 ? $" · {string.Join(", ", Model.Teams)}" : "")
    </p>
    <p class="session-sub">
        Only your team's admins can see this, and it is used to reach you about sessions. Your address
        is not published anywhere.
    </p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="vesm-alert error"></div>

        <div class="field">
            <label asp-for="Input.Name">Name</label>
            <input asp-for="Input.Name" />
            <span asp-validation-for="Input.Name"></span>
        </div>

        <div class="field">
            <label asp-for="Input.Phone">Phone</label>
            <input asp-for="Input.Phone" type="tel" />
        </div>

        <div class="field">
            <label asp-for="Input.AddressLine1">Address</label>
            <input asp-for="Input.AddressLine1" placeholder="Street address" />
            <input asp-for="Input.AddressLine2" placeholder="Apt, suite (optional)" />
        </div>

        <div class="field-row">
            <div class="field"><label asp-for="Input.City">City</label><input asp-for="Input.City" /></div>
            <div class="field"><label asp-for="Input.State">State</label><input asp-for="Input.State" /></div>
            <div class="field"><label asp-for="Input.PostalCode">ZIP</label><input asp-for="Input.PostalCode" /></div>
        </div>

        <div class="field">
            <label asp-for="Input.DiscordUsername">Discord username</label>
            <input asp-for="Input.DiscordUsername" />
        </div>

        <div class="field">
            <label asp-for="Input.ContactPreference">How should we contact you?</label>
            <select asp-for="Input.ContactPreference">
                <option value="@((int)VeContactPreference.Email)">Email</option>
                @* Disabled until SMS exists — offering it would quietly stop them being contacted. *@
                <option value="@((int)VeContactPreference.Text)" disabled>Text (not available yet)</option>
                <option value="@((int)VeContactPreference.Both)" disabled>Email and text (not available yet)</option>
            </select>
        </div>

        <button type="submit" class="btn-primary btn-sm">Save my details</button>
    </form>
</div>

<div class="ve-panel">
    <h2>Email address</h2>
    <p class="session-sub">
        Currently <strong>@Model.Person.Email</strong>. This is where your sign-in links go, so a
        change has to be confirmed from this address before it takes effect.
    </p>

    <form method="post" asp-page-handler="ChangeEmail">
        <div class="field">
            <label for="NewEmail">New email address</label>
            <input id="NewEmail" name="NewEmail" type="email" required />
        </div>
        <button type="submit" class="btn-secondary btn-sm">Send confirmation to my current address</button>
    </form>
</div>

@if (Model.Subscriptions.Count > 0 || Model.Person.EmailUnsubscribedUtc is not null)
{
    <div class="ve-panel">
        <h2>Email preferences</h2>

        @if (Model.Person.EmailUnsubscribedUtc is { } unsubscribed)
        {
            @* An unsubscribe overrides everything, so saying so here is the difference between a VE
               understanding why they hear nothing and assuming the app is broken. *@
            <div class="vesm-alert error">
                You unsubscribed from email on @EasternTimeFormatter.Format(unsubscribed, "MMM d, yyyy").
                We are not sending you anything, including invitations to work sessions. Use the
                unsubscribe link in any earlier message to start receiving email again.
            </div>
        }

        @if (Model.Subscriptions.Count > 0)
        {
            <p class="session-sub">
                These teams email their VEs about upcoming sessions. Tick the ones you want to hear from.
            </p>
            <form method="post" asp-page-handler="Subscriptions">
                @foreach (var subscription in Model.Subscriptions)
                {
                    <label class="switch-row">
                        <input type="checkbox" name="subscribedTeamIds" value="@subscription.TeamId"
                               checked="@subscription.Subscribed" style="width:auto;" />
                        <span>Email me about @subscription.TeamName sessions</span>
                    </label>
                }
                <button type="submit" class="btn-secondary btn-sm" style="margin-top:12px;">Save email preferences</button>
            </form>
        }
    </div>
}

<div class="ve-panel">
    <h2>VEC accreditations</h2>
    <p class="session-sub">
        Which VECs you're accredited with. Nobody publishes this to us, so it's yours to keep
        accurate — your team sees it when they're working out who can serve at a session.
    </p>

    <table class="cards">
        <thead><tr><th>VEC</th><th></th></tr></thead>
        <tbody>
            @if (Model.Person.VecAccreditations.Count == 0)
            {
                <tr><td colspan="2">None recorded yet.</td></tr>
            }
            @foreach (var accreditation in Model.Person.VecAccreditations.OrderBy(a => a.Vec.Name))
            {
                <tr>
                    <td>@accreditation.Vec.Name</td>
                    <td>
                        <form method="post" asp-page-handler="RemoveAccreditation">
                            <input type="hidden" name="accreditationId" value="@accreditation.Id" />
                            <button type="submit" class="btn-secondary btn-sm">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @* Only VECs they don't already hold, so the picker can't offer a duplicate. The service rejects
       one anyway; this keeps the list from suggesting it. *@
    @{
        var held = Model.Person.VecAccreditations.Select(a => a.VecId).ToHashSet();
        var addable = Model.AllVecs.Where(v => !held.Contains(v.Id)).ToList();
    }
    @if (addable.Count > 0)
    {
        <form method="post" asp-page-handler="AddAccreditation" class="field-row">
            <div class="field">
                <label for="vecId">VEC</label>
                <select id="vecId" name="vecId" class="filter-select" required>
                    @foreach (var vec in addable)
                    {
                        <option value="@vec.Id">@vec.Name</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn-secondary btn-sm">Add</button>
        </form>
    }
</div>

<div class="ve-panel">
    <form method="post" asp-page-handler="SignOut">
        <button type="submit" class="btn-secondary btn-sm">Sign out</button>
    </form>
</div>

@* Without this, asp-validation-for renders the markup but nothing populates it: every check becomes
   a round trip and the message only appears after a POST. Server-side validation is unaffected and
   remains the actual enforcement (#314, L-15). *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
