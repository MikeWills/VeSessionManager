@page "/youth-confirm/{token:guid}"
@model VeSessionManager.Web.Pages.Public.YouthConfirmModel
@using VeSessionManager.Core.Payments
@{
    ViewData["Title"] = "Youth Rate Confirmation";
    Layout = "_PublicLayout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Youth Rate Confirmation</h1>

        @if (Model.Outcome == YouthConfirmationOutcome.Success)
        {
            @* Team-editable (Team Settings > Email Settings), 2026-08-26 — see EmailSettings.
               YouthConfirmIntroHtml's own remarks for why raw team-authored HTML is trusted here at
               the same level as a message rule body. No ARRL claim-form URL in the shipped default,
               deliberately (#192): that form is an external ARRL document this app neither hosts nor
               tracks, and a link that rots on a page candidates are sent to is worse than no link —
               the post-exam ArrlYouthProgramInstructions email already carries it, once it matters. *@
            <div class="policy-note">@Html.Raw(Model.IntroHtml)</div>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="field-error"></div>
                <div class="field">
                    <label>
                        <input asp-for="Input.ConfirmYouth" style="width:auto; display:inline-block;" />
                        I confirm I am a youth (under 18).
                    </label>
                    <span asp-validation-for="Input.ConfirmYouth" class="field-error"></span>
                </div>

                @* Was a reminder-only paragraph until 2026-08-26 — now an actual recorded
                   declaration, since COPPA testing cannot legally proceed without the parental
                   consent form on file, and this page is the one honor-system checkpoint candidates
                   pass through before paying. "" as the unselected option, not omitted, so a select
                   with no JS still posts something distinguishable from a real answer. *@
                <div class="field">
                    <label for="declaredUnder13">Is the candidate under the age of 13?</label>
                    <select id="declaredUnder13" asp-for="Input.DeclaredUnder13"
                            data-select-panel="coppaPanel" data-select-panel-value="True">
                        <option value="">Select one</option>
                        <option value="false">No</option>
                        <option value="true">Yes</option>
                    </select>
                    <span asp-validation-for="Input.DeclaredUnder13" class="field-error"></span>
                </div>

                <div id="coppaPanel" style="@(Model.Input.DeclaredUnder13 == true ? "" : "display:none;")">
                    <p class="policy-note">
                        If you are not 13 years of age or older you may not register for any exam
                        session through HamStudy.org or ExamTools.org until your parent or guardian
                        has filled out our
                        <a href="https://blog.hamstudy.org/wp-content/uploads/2020/05/ExamTools_COPPA_form.pdf"
                           target="_blank" rel="noopener noreferrer">COPPA Parental Consent Form</a>
                        and emailed it to <a href="mailto:coppa@examtools.org">coppa@examtools.org</a>.
                    </p>
                    <div class="field">
                        <label>
                            <input asp-for="Input.CoppaFormSent" style="width:auto; display:inline-block;" />
                            I have sent this form to ExamTools.
                        </label>
                        <span asp-validation-for="Input.CoppaFormSent" class="field-error"></span>
                    </div>
                </div>

                <button type="submit" class="btn-primary">Continue to $5 payment</button>
            </form>
        }
        else if (Model.Outcome == YouthConfirmationOutcome.AlreadyResolved)
        {
            <p class="policy-note">This payment has already been resolved — there's nothing left to confirm here. If that doesn't seem right, contact your Volunteer Examiner team.</p>
        }
        else if (Model.Outcome == YouthConfirmationOutcome.FeeNotConfigured || Model.Outcome == YouthConfirmationOutcome.SquareNotConfigured)
        {
            <p class="policy-note">The youth rate isn't fully set up yet for this session. Please contact your Volunteer Examiner team directly instead of using this link.</p>
        }
        else
        {
            <p class="policy-note">This link isn't valid. Please contact your Volunteer Examiner team if you believe this is an error.</p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
