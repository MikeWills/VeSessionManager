@page "/youth-confirm/{token:guid}"
@model VeSessionManager.Web.Pages.Public.YouthConfirmModel
@using VeSessionManager.Core.Payments
@{
    ViewData["Title"] = "Youth Rate Confirmation";
    Layout = "_PublicLayout";
}

<div class="auth-wrap">
    <div class="auth-card">
        <h1>Youth Rate Confirmation</h1>

        @if (Model.Outcome == YouthConfirmationOutcome.Success)
        {
            @* No ARRL URL here, deliberately (#192). The claim form is an external ARRL document
               this app neither hosts nor tracks, and the address for it has changed before — a link
               that rots on a page candidates are sent to is worse than no link. The existing
               post-exam ArrlYouthProgramInstructions email already points at it, and takes the same
               approach for the same reason. A candidate cannot claim before passing anyway, so
               nothing is lost by saying so here and sending the detail when it is useful. *@
            <p class="policy-note">
                <strong>After you pass, you may be able to claim the FCC license fee back.</strong>
                ARRL runs a youth program that reimburses the FCC application fee for candidates
                under 18. It is separate from the reduced exam fee below, and it is claimed after you
                have your call sign — not now. We will send you the form and instructions once your
                license is granted.
            </p>
            <p class="policy-note">
                <strong>Under 13?</strong> ExamTools requires a separate COPPA consent form, signed
                by a parent or guardian, before you can be tested. Ask your VE team for it and send
                the completed form back to them
                @if (!string.IsNullOrWhiteSpace(Model.TeamContactEmail))
                {
                    <text>at <a href="mailto:@Model.TeamContactEmail">@Model.TeamContactEmail</a></text>
                }
                before your session. This is a reminder only — nothing on this page confirms or
                records it.
            </p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="field-error"></div>
                <div class="field">
                    <label>
                        <input asp-for="Input.ConfirmYouth" style="width:auto; display:inline-block;" />
                        I confirm I am a youth (under 18).
                    </label>
                    <span asp-validation-for="Input.ConfirmYouth" class="field-error"></span>
                </div>
                <button type="submit" class="btn-primary">Continue to $5 payment</button>
            </form>
        }
        else if (Model.Outcome == YouthConfirmationOutcome.AlreadyResolved)
        {
            <p class="policy-note">This payment has already been resolved — there's nothing left to confirm here. If that doesn't seem right, contact your Volunteer Examiner team.</p>
        }
        else if (Model.Outcome == YouthConfirmationOutcome.FeeNotConfigured || Model.Outcome == YouthConfirmationOutcome.SquareNotConfigured)
        {
            <p class="policy-note">The youth rate isn't fully set up yet for this session. Please contact your Volunteer Examiner team directly instead of using this link.</p>
        }
        else
        {
            <p class="policy-note">This link isn't valid. Please contact your Volunteer Examiner team if you believe this is an error.</p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
