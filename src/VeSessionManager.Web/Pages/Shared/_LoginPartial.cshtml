@using Microsoft.AspNetCore.Identity
@using VeSessionManager.Core.Entities
@using VeSessionManager.Web
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    <li class="nav-item">
        <a class="nav-link text-dark" asp-page="@(currentUser is null ? "/Index" : RoleLandingPages.GetPath(currentUser.Role))">@User.Identity?.Name</a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-page="/Account/Logout" method="post">
            <button type="submit" class="nav-link btn btn-link">Log out</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" asp-page="/Account/Login">Log in</a>
    </li>
}
</ul>
