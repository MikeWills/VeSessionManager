@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VeSessionManager.Core.Authorization
@using VeSessionManager.Core.Data
@using VeSessionManager.Core.Entities
@using VeSessionManager.Core.Navigation
@inject UserManager<User> UserManager
@inject AppDbContext DbContext
@inject SessionAccessScope AccessScope
@inject NavBadgeCountService NavBadgeCounts
@{
    // One load per request, shared with the page handler that already did this — see
    // CurrentUserLoader.GetCachedUserWithManagerAsync. This block used to issue a bare GetUserAsync
    // and then a second, fully-included query on top of it, on every authenticated page render.
    var currentUser = await UserManager.GetCachedUserWithManagerAsync(DbContext, Context, User);
    var teamName = "All Teams";
    // null means "every team" for a SystemAdmin, not "no teams" — see NavBadgeCountService's own
    // remarks. Kept null rather than coalesced so the badge queries below stay unscoped for them.
    IReadOnlyList<int>? effectiveTeamIds = null;
    if (currentUser is not null && currentUser.Role != UserRole.SystemAdmin)
    {
        // UserTeams (and, for a TeamLead, ManagedByUser.UserTeams) are already included by the
        // loader above — GetEffectiveTeamIds silently returns an empty set without them.
        effectiveTeamIds = AccessScope.GetEffectiveTeamIds(currentUser) ?? [];
        teamName = effectiveTeamIds.Count switch
        {
            0 => "Unassigned Team",
            1 => (await DbContext.Teams.FindAsync(effectiveTeamIds[0]))?.Name ?? "Unassigned Team",
            _ => $"{effectiveTeamIds.Count} teams"
        };
    }

    var badges = currentUser is null
        ? new NavBadgeCounts(0, 0, 0, 0)
        : await NavBadgeCounts.GetCountsAsync(effectiveTeamIds, Context.RequestAborted);

    var roleLabel = currentUser?.Role switch
    {
        UserRole.SystemAdmin => "System Admin",
        UserRole.TeamAdmin => "Team Admin",
        UserRole.SessionManager => "Session Manager",
        UserRole.TeamLead => "Team Lead",
        _ => ""
    };

    // The user menu's trigger answers "who am I signed in as", so it shows the name. Role and team
    // scope moved inside the menu (2026-08-07): "System Admin All Teams" on the button read as a
    // filter or a page title rather than an account, which is confusing precisely because it never
    // said whose account it was. Email is the fallback for a row with no display name.
    var displayName = !string.IsNullOrWhiteSpace(currentUser?.Name) ? currentUser!.Name
        : !string.IsNullOrWhiteSpace(currentUser?.Email) ? currentUser!.Email!
        : "Account";

    var activeNav = ViewData["ActiveNav"] as string;
    var mainClass = "vesm-main" + (ViewData["WideMain"] is true ? " wide" : "");

    // Grouped nav dropdowns — whether the trigger itself should show as "active" because the
    // current page is one of its children (the individual links inside still get their own
    // .active state too, same as before).
    var applicantsGroupActive = activeNav is "ApplicantStatus" or "RenewalMonitor";
    var vesGroupActive = activeNav is "VeRoster" or "VeDirectory" or "VeTags" or "VeImport" or "AuditioningReport";
    var settingsGroupActive = activeNav is "AdminTeams" or "AdminTeamSettings" or "AdminUsers" or "AdminEmailTemplates"
        or "AdminFees" or "AdminVecs" or "AdminAuditLog" or "AdminJobHistory" or "AdminJobSchedule" or "Reconciliation" or "AdminSystemSettings";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VeSessionManager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    @* Self-hosted: the CSP allows font-src 'self' only (plus Google Fonts), and a CDN
       reference would be blocked. Loaded before app.css so the design system can override it. *@
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @* For page-specific stylesheets that shouldn't load site-wide — currently only Quill's, on the
       Email Templates page. Mirrors the existing Scripts section at the bottom. *@
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="vesm">
    <header class="chassis">
        <a class="brand" asp-page="/SessionManager/Index"><span class="dot"></span>VESESSIONMGR</a>
        @* Mobile-only nav toggle (hidden from 768px up by app.css). It reveals both the nav links
           and the .who cluster, which are one collapsed panel below the breakpoint — see the
           "Chassis nav" comment in app.css. app.js keeps aria-expanded in step. *@
        <button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-label="Menu"><span class="bars"></span></button>
        <nav class="chassis-nav">
            @* The VEC-submission badge rides on Sessions since the standalone VEC Submission page was
               removed as redundant — that worklist is now the Sessions page's "Pending VEC submission"
               status filter. Titled because a bare number next to "Sessions" wouldn't say what it counts. *@
            <a asp-page="/SessionManager/Index" class="@(activeNav == "Sessions" ? "active" : "")"
               title="@(badges.SessionsPendingVecSubmission > 0 ? $"{badges.SessionsPendingVecSubmission} session(s) pending VEC submission" : null)">
                Sessions
                @if (badges.SessionsPendingVecSubmission > 0)
                {
                    <span class="nav-badge">@badges.SessionsPendingVecSubmission</span>
                }
            </a>
            @* Applicants/VEs are deliberately dropdowns even at one item today — they're the homes
               more applicant- and VE-facing pages land in, so the nav doesn't reshuffle later. The
               Applicants badge sits on the trigger since a badge inside a closed menu is invisible. *@
            <div class="nav-group">
                <button type="button" class="kebab @(applicantsGroupActive ? "active" : "")">
                    Applicants
                    @if (badges.ApplicantsPendingGrant > 0)
                    {
                        <span class="nav-badge">@badges.ApplicantsPendingGrant</span>
                    }
                    <i class="bi bi-caret-down-fill" aria-hidden="true"></i>
                </button>
                <div class="menu">
                    <a class="item @(activeNav == "ApplicantStatus" ? "active" : "")" asp-page="/SessionManager/ApplicantStatus">Applicant Status</a>
                    @* Filed under Applicants because a renewal is, technically, an application —
                       and it keeps every "waiting on FCC" screen in one place. No role gate, matching
                       RenewalMonitor's bare [Authorize]; the two must stay in step. *@
                    <a class="item @(activeNav == "RenewalMonitor" ? "active" : "")" asp-page="/SessionManager/RenewalMonitor">Renewal Monitor</a>
                </div>
            </div>
            @* Gated to match VeRoster.cshtml.cs's own [Authorize] — the roster is a full VE contact
               list plus a per-VE session-count leaderboard, restricted to admin roles (2026-08-01).
               Same rule as UnmatchedPayments below: never render a link the user's role will 403 on. *@
            @if (currentUser?.Role is UserRole.SystemAdmin or UserRole.TeamAdmin)
            {
                <div class="nav-group">
                    <button type="button" class="kebab @(vesGroupActive ? "active" : "")">VEs <i class="bi bi-caret-down-fill" aria-hidden="true"></i></button>
                    <div class="menu">
                        <a class="item @(activeNav == "VeDirectory" ? "active" : "")" asp-page="/SessionManager/VeDirectory">VE Directory</a>
                        <a class="item @(activeNav == "VeRoster" ? "active" : "")" asp-page="/SessionManager/VeRoster">VE Session Counts</a>
                        <a class="item @(activeNav == "AuditioningReport" ? "active" : "")" asp-page="/SessionManager/AuditioningReport">Auditioning Report</a>
                        <hr>
                        <a class="item @(activeNav == "VeTags" ? "active" : "")" asp-page="/SessionManager/VeTags">VE Tags</a>
                        <a class="item @(activeNav == "VeImport" ? "active" : "")" asp-page="/SessionManager/VeImport">Import VEs</a>
                    </div>
                </div>
            }
            @* Gated to match UnmatchedPayments.cshtml.cs's own [Authorize] — a TeamLead previously
               saw this link and got a 403 on click. *@
            @if (currentUser?.Role is not UserRole.TeamLead)
            {
                <a asp-page="/SessionManager/UnmatchedPayments" class="@(activeNav == "UnmatchedPayments" ? "active" : "")">
                    Unmatched Payments
                    @if (badges.UnresolvedUnmatchedPayments > 0)
                    {
                        <span class="nav-badge">@badges.UnresolvedUnmatchedPayments</span>
                    }
                </a>
            }
            @if (currentUser?.Role is UserRole.SystemAdmin or UserRole.TeamAdmin)
            {
                <div class="nav-group">
                    <button type="button" class="kebab @(settingsGroupActive ? "active" : "")">Settings <i class="bi bi-caret-down-fill" aria-hidden="true"></i></button>
                    <div class="menu">
                        @* Visible to TeamAdmin as well, scoped to their own teams — it is the entry
                           point for every per-team page now, so gating it would strand the role. *@
                        <a class="item @(activeNav == "AdminTeams" ? "active" : "")" asp-page="/Admin/Teams">Teams</a>
                        @* Team Settings, Team Maintenance and Email Templates are deliberately NOT
                           here (2026-08-06). Each needs one team chosen, so a nav link lands on
                           "Select a team…" while the Teams row menu picks the team for you — a
                           strictly better route, now that Teams is reachable by TeamAdmin too.

                           Users stays: unlike those three it is genuinely cross-team for a
                           SystemAdmin (no team selected lists every user), so routing them through
                           one team's row would make the global list harder to reach, not easier. *@
                        <a class="item @(activeNav == "AdminUsers" ? "active" : "")" asp-page="/Admin/Users">Users</a>
                        <hr>
                        @* Fees is deliberately not here either — it always scopes to exactly one VEC,
                           so the VECs row menu is the honest way in, and it is SystemAdmin-only
                           (2026-08-06) because a fee configuration is shared across every team. *@
                        @if (currentUser?.Role is UserRole.SystemAdmin)
                        {
                            <a class="item @(activeNav == "AdminVecs" ? "active" : "")" asp-page="/Admin/Vecs">VECs</a>
                        }
                        <hr>
                        <a class="item @(activeNav == "AdminAuditLog" ? "active" : "")" asp-page="/Admin/AuditLog">Audit Log</a>
                        <a class="item @(activeNav == "AdminJobHistory" ? "active" : "")" asp-page="/Admin/JobRunHistory">Job History</a>
                        <a class="item @(activeNav == "AdminJobSchedule" ? "active" : "")" asp-page="/Admin/JobSchedule">Job Schedule</a>
                        @* Beside Job History and Job Schedule because it is the same kind of thing —
                           is the machinery actually doing its job — and the badge is what makes it
                           worth having rather than another page to remember to open. *@
                        <a class="item @(activeNav == "Reconciliation" ? "active" : "")" asp-page="/Admin/Reconciliation">
                            Reconciliation
                            @if (badges.OpenReconciliationFindings > 0)
                            {
                                <span class="nav-badge">@badges.OpenReconciliationFindings</span>
                            }
                        </a>
                        @if (currentUser?.Role is UserRole.SystemAdmin)
                        {
                            <hr>
                            <a class="item @(activeNav == "AdminSystemSettings" ? "active" : "")" asp-page="/Admin/SystemSettings">System Settings</a>
                        }
                    </div>
                </div>
            }
        </nav>
        <div class="who">
            <div class="user-menu">
                <button type="button" class="kebab">@displayName <i class="bi bi-caret-down-fill" aria-hidden="true"></i></button>
                <div class="menu">
                    @* Not an action — the role and the team scope this account sees, kept because
                       they are worth knowing, just not on the button. *@
                    <div class="menu-head">@roleLabel &middot; @teamName</div>
                    <hr>
                    <a class="item" asp-page="/Account/ChangePassword">Change password</a>
                    @* Shown to everyone, not only linked accounts: the page's own unlinked state is
                       how someone finds out the link exists and can be asked for. Hiding it would
                       make it discoverable only to people who already have it. *@
                    <a class="item" asp-page="/Account/MyVeDetails">My VE details</a>
                    @* Directly above Log out on purpose: "log out" is what someone reaches for when
                       a device goes missing, and this is the thing they actually need. *@
                    <a class="item" asp-page="/Account/SignOutOtherDevices">Sign out other devices</a>
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="item">Log out</button>
                    </form>
                </div>
            </div>
            <div class="help-menu">
                <button type="button" class="kebab" aria-label="Help">Help <i class="bi bi-caret-down-fill" aria-hidden="true"></i></button>
                <div class="menu">
                    <a class="item" href="https://github.com/MikeWills/VeSessionManager/issues" target="_blank" rel="noopener noreferrer">Support</a>
                    <button type="button" class="item" disabled title="Coming soon">Documentation</button>
                </div>
            </div>
            <button id="themeToggle" class="theme-toggle" type="button"></button>
        </div>
    </header>
    <partial name="_TestModeBanner" />
    @* Admin-only, and cached — see the partial's own comments. Passed the role rather than
       re-querying the user the layout has already loaded. *@
    <partial name="_IngestionHealthBanner" model="currentUser?.Role" />

    <main class="@mainClass">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="vesm-alert success">@statusMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="vesm-alert error">@errorMessage</div>
        }
        @RenderBody()
    </main>

    <footer class="vesm-footer">
        <span>VE Session Manager @VeSessionManager.Core.AppVersion.Display</span>
        <a asp-page="/Privacy">Privacy</a>
    </footer>

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
