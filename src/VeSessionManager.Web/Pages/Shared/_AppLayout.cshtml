@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VeSessionManager.Core.Authorization
@using VeSessionManager.Core.Data
@using VeSessionManager.Core.Entities
@inject UserManager<User> UserManager
@inject AppDbContext DbContext
@inject SessionAccessScope AccessScope
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var teamName = "All Teams";
    if (currentUser is not null && currentUser.Role != UserRole.SystemAdmin)
    {
        // UserTeams (and, for a TeamLead, ManagedByUser.UserTeams) must be loaded before calling
        // GetEffectiveTeamIds — UserManager.GetUserAsync doesn't include either.
        currentUser = await DbContext.Users
            .Include(u => u.UserTeams)
            .Include(u => u.ManagedByUser).ThenInclude(m => m!.UserTeams)
            .FirstAsync(u => u.Id == currentUser.Id);

        var teamIds = AccessScope.GetEffectiveTeamIds(currentUser) ?? [];
        teamName = teamIds.Count switch
        {
            0 => "Unassigned Team",
            1 => (await DbContext.Teams.FindAsync(teamIds[0]))?.Name ?? "Unassigned Team",
            _ => $"{teamIds.Count} teams"
        };
    }

    var roleLabel = currentUser?.Role switch
    {
        UserRole.SystemAdmin => "System Admin",
        UserRole.TeamAdmin => "Team Admin",
        UserRole.SessionManager => "Session Manager",
        UserRole.TeamLead => "Team Lead",
        _ => ""
    };

    var activeNav = ViewData["ActiveNav"] as string;
    var mainClass = "vesm-main" + (ViewData["WideMain"] is true ? " wide" : "");

    // Grouped nav dropdowns — whether the trigger itself should show as "active" because the
    // current page is one of its children (the individual links inside still get their own
    // .active state too, same as before).
    var teamGroupActive = activeNav is "AdminTeams" or "AdminTeamSettings" or "AdminUsers" or "AdminEmailTemplates";
    var vecFeesGroupActive = activeNav is "AdminVecs" or "AdminFees";
    var reportsGroupActive = activeNav is "AdminAuditLog" or "AdminJobHistory";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VeSessionManager</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="vesm">
    <header class="chassis">
        <a class="brand" asp-page="/SessionManager/Index"><span class="dot"></span>VESESSIONMGR</a>
        <nav class="chassis-nav">
            <a asp-page="/SessionManager/Index" class="@(activeNav == "Sessions" ? "active" : "")">Sessions</a>
            <a asp-page="/SessionManager/VeRoster" class="@(activeNav == "VeRoster" ? "active" : "")">VE Roster</a>
            <a asp-page="/SessionManager/ApplicantStatus" class="@(activeNav == "ApplicantStatus" ? "active" : "")">Applicant Status</a>
            <a asp-page="/SessionManager/VecSubmission" class="@(activeNav == "VecSubmission" ? "active" : "")">VEC Submission</a>
            <a asp-page="/SessionManager/UnmatchedPayments" class="@(activeNav == "UnmatchedPayments" ? "active" : "")">Unmatched Payments</a>
            @if (currentUser?.Role is UserRole.SystemAdmin or UserRole.TeamAdmin)
            {
                <div class="nav-group">
                    <button type="button" class="kebab @(teamGroupActive ? "active" : "")">Team ▾</button>
                    <div class="menu">
                        @if (currentUser?.Role is UserRole.SystemAdmin)
                        {
                            <a class="item @(activeNav == "AdminTeams" ? "active" : "")" asp-page="/Admin/Teams">Teams</a>
                        }
                        <a class="item @(activeNav == "AdminTeamSettings" ? "active" : "")" asp-page="/Admin/TeamSettings">Team Settings</a>
                        <a class="item @(activeNav == "AdminUsers" ? "active" : "")" asp-page="/Admin/Users">Users</a>
                        <a class="item @(activeNav == "AdminEmailTemplates" ? "active" : "")" asp-page="/Admin/EmailTemplates">Email Templates</a>
                    </div>
                </div>
                <div class="nav-group">
                    <button type="button" class="kebab @(vecFeesGroupActive ? "active" : "")">VEC &amp; Fees ▾</button>
                    <div class="menu">
                        <a class="item @(activeNav == "AdminFees" ? "active" : "")" asp-page="/Admin/FeeConfigurations">Fees</a>
                        @if (currentUser?.Role is UserRole.SystemAdmin)
                        {
                            <a class="item @(activeNav == "AdminVecs" ? "active" : "")" asp-page="/Admin/Vecs">VECs</a>
                        }
                    </div>
                </div>
                <div class="nav-group">
                    <button type="button" class="kebab @(reportsGroupActive ? "active" : "")">Reports ▾</button>
                    <div class="menu">
                        <a class="item @(activeNav == "AdminAuditLog" ? "active" : "")" asp-page="/Admin/AuditLog">Audit Log</a>
                        <a class="item @(activeNav == "AdminJobHistory" ? "active" : "")" asp-page="/Admin/JobRunHistory">Job History</a>
                    </div>
                </div>
            }
            @if (currentUser?.Role is UserRole.SystemAdmin)
            {
                <a asp-page="/Admin/SystemSettings" class="@(activeNav == "AdminSystemSettings" ? "active" : "")">System Settings</a>
            }
        </nav>
        <div class="who">
            <div class="user-menu">
                <button type="button" class="kebab"><span class="role">@roleLabel</span> @teamName ▾</button>
                <div class="menu">
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="item">Log out</button>
                    </form>
                </div>
            </div>
            <div class="help-menu">
                <button type="button" class="kebab" aria-label="Help">Help ▾</button>
                <div class="menu">
                    <a class="item" href="https://github.com/MikeWills/VeSessionManager/issues" target="_blank" rel="noopener noreferrer">Support</a>
                    <button type="button" class="item" disabled title="Coming soon">Documentation</button>
                </div>
            </div>
            <button id="themeToggle" class="theme-toggle" type="button"></button>
        </div>
    </header>
    <partial name="_TestModeBanner" />

    <main class="@mainClass">
        @if (TempData["StatusMessage"] is string statusMessage)
        {
            <div class="vesm-alert success">@statusMessage</div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="vesm-alert error">@errorMessage</div>
        }
        @RenderBody()
    </main>

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
