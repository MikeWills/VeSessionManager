@page "{id:int}"
@using VeSessionManager.Core.Entities
@using VeSessionManager.Core.ExamTools
@using VeSessionManager.Core.VecSubmissions
@model VeSessionManager.Web.Pages.SessionManager.SubmitToVecModel
@{
    ViewData["Title"] = "Submit to ARRL-VEC";
    var preview = Model.Preview;
}

<div class="vesm">
    <div class="session-head">
        <h1>Submit to ARRL-VEC</h1>
        <p class="session-sub">
            <a asp-page="Detail" asp-route-id="@Model.Id">&larr; Back to the session</a>
        </p>
    </div>

@if (preview is null || preview.Status == ArrlSubmissionPreviewStatus.SessionNotFound)
{
    <p>That session could not be found.</p>
}
else if (preview.Status == ArrlSubmissionPreviewStatus.NotAnArrlSession)
{
    @* One submitter, no fallback. A session under another VEC is told plainly rather than being
       handed ARRL's form, which would file it with the wrong coordinator. *@
    <p><strong>This session is not run under ARRL-VEC.</strong></p>
    <p class="session-sub">
        Only ARRL sessions can be filed from this app &mdash; every VEC has its own process. Use your
        VEC's normal method, then mark the session submitted on the session page.
    </p>
}
else if (preview.Status == ArrlSubmissionPreviewStatus.TeamNotConfigured)
{
    <p><strong>@preview.TeamName has not set up ARRL submissions yet.</strong></p>
    <p class="session-sub">
        A location, a payment method and an email choice are needed before a form can be filled in.
        Set them under <a asp-page="/Admin/TeamSettings">Team settings &rarr; ARRL submissions</a>.
    </p>
}
else
{
    <div class="section-head"><h2>@preview.SessionTitle</h2></div>

    @if (preview.AlreadySubmitted)
    {
        <p><strong>This session is already marked as submitted to its VEC.</strong> Filing it again would
        send ARRL a second copy &mdash; there is no way to withdraw one.</p>
    }

    <p class="session-sub">
        This is exactly what will be sent to ARRL. Everything is editable &mdash; what is on screen is
        what gets filed. <strong>There is no way to withdraw a submission</strong>, so read it before
        pressing the button.
    </p>

    @if (preview.MissingRequiredFields.Count > 0)
    {
        <div class="section-head" style="margin-top:20px;"><h2>Missing information</h2></div>
        <p>ARRL requires these, and they could not be filled in:</p>
        <ul>
            @foreach (var field in preview.MissingRequiredFields)
            {
                <li><strong>@field</strong></li>
            }
        </ul>
        <p class="session-sub">
            The contact details come from the session's lead VE. ExamTools does not supply them, so they
            are only ever entered by an admin or the VE &mdash; and a VE whose details have been through
            the retention purge will have none. Fill them in on the VE's own record, or enter them here
            once this screen can submit.
        </p>
    }

    @* Explicit action + asp-antiforgery: asp-page-handler builds the action from the route only and
       drops the query string, and an explicit action stops FormTagHelper emitting the token, which
       then 400s in the antiforgery middleware before reaching the app with nothing logged. Both
       halves are needed together (CLAUDE.md, Known Constraints). *@
    <form method="post" asp-page-handler="Submit" enctype="multipart/form-data" asp-antiforgery="true">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="section-head" style="margin-top:20px;"><h2>The form</h2></div>

        <div class="field" style="max-width:520px;">
            <label for="fullName">Full name</label>
            <input id="fullName" name="fullName" type="text" value="@preview.FullName" required />
        </div>
        <div class="field" style="max-width:260px;">
            <label for="callSign">Call sign</label>
            <input id="callSign" name="callSign" type="text" value="@preview.CallSign" required />
        </div>
        <div class="field" style="max-width:420px;">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" value="@preview.Email" required />
        </div>
        <div class="field" style="max-width:260px;">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="text" value="@preview.Phone" required />
        </div>
        <div class="field" style="max-width:220px;">
            <label for="sessionDate">Exam session date</label>
            <input id="sessionDate" name="sessionDate" type="date" value="@preview.SessionDate" required />
        </div>
        <div class="field" style="max-width:420px;">
            <label for="location">Exam session location</label>
            <input id="location" name="location" type="text" value="@preview.Location" required />
        </div>
        <div class="field" style="max-width:420px;">
            <label for="paymentMethod">Method of payment</label>
            <select id="paymentMethod" name="paymentMethod">
                <option value="@ArrlPaymentMethod.MailIn" selected="@(preview.PaymentMethod == ArrlPaymentMethod.MailIn)">Mail in payment</option>
                <option value="@ArrlPaymentMethod.PhoneIn" selected="@(preview.PaymentMethod == ArrlPaymentMethod.PhoneIn)">Phone in payment</option>
                <option value="@ArrlPaymentMethod.CreditCardOnFile" selected="@(preview.PaymentMethod == ArrlPaymentMethod.CreditCardOnFile)">Credit card on file with VEC</option>
            </select>
        </div>
        <div class="field" style="max-width:200px;">
            <label for="amountCharged">Amount forwarded to ARRL VEC</label>
            <input id="amountCharged" name="amountCharged" type="text" value="@preview.AmountCharged" inputmode="decimal" />
        </div>

        @* The arithmetic, not just the total: the figure comes from payments received, and two
           ordinary situations make that differ from what is owed. *@
        @if (preview.Fees is { } fees)
        {
            <p class="session-sub">
                Collected @Usd.Format(fees.TotalCollected) &middot; retained @Usd.Format(fees.TotalRetained)
                &middot; forwarded @Usd.Format(fees.TotalRemitToVec).
            </p>
        }
        @foreach (var warning in preview.AmountWarnings)
        {
            <p><strong>Check this:</strong> @warning</p>
        }

        <div class="field" style="max-width:640px;">
            <label for="note">Notes</label>
            <textarea id="note" name="note" rows="3">@preview.Note</textarea>
        </div>

        <div class="section-head" style="margin-top:20px;"><h2>Files</h2></div>
        @if (preview.ArchiveOutcome == VecArchiveDownloadOutcome.Succeeded)
        {
            <p><span class="mono">@preview.ArchiveFileName</span> &mdash; @(preview.ArchiveByteCount / 1024)KB, fetched from ExamTools. It is downloaded again when you press the button, so it is never stale.</p>
        }
        else if (preview.ArchiveOutcome == VecArchiveDownloadOutcome.SessionNotComplete)
        {
            <p><strong>ExamTools has no archive for this session yet.</strong></p>
            <p class="session-sub">It said: &ldquo;@preview.ArchiveMessage&rdquo; &mdash; close the session in ExamTools and this page will find it.</p>
        }
        else
        {
            <p><strong>The VEC archive could not be downloaded.</strong> @preview.ArchiveMessage</p>
        }

        <div class="field" style="max-width:520px;">
            <label for="attachment">One more file (optional)</label>
            <input id="attachment" name="attachment" type="file" accept=".pdf,.doc,.docx,.json,.zip" />
        </div>
        <p class="session-sub">
            For the youth grant program form. PDF, DOC, DOCX, JSON or ZIP, up to 40MB. ARRL takes at
            most two files, so this is the second.
        </p>
        @if (preview.YouthFormExpected)
        {
            <p><strong>This session has a youth-rate payment</strong>, so ARRL will be expecting the youth grant program form here.</p>
        }

        @if (Model.CanEdit && preview.CanSubmit)
        {
            <p style="margin-top:20px;"><strong>This cannot be undone.</strong> Once sent, correcting a filing means contacting ARRL.</p>
            <button type="submit" class="btn-primary">Send to ARRL-VEC</button>
        }
        else if (!Model.CanEdit)
        {
            <p class="session-sub" style="margin-top:20px;">You have read-only access to this session.</p>
        }
        else
        {
            <p class="session-sub" style="margin-top:20px;">This cannot be sent yet &mdash; see above.</p>
        }
    </form>
}
</div>
