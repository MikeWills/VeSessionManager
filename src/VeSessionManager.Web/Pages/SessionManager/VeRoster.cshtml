@page
@model VeSessionManager.Web.Pages.SessionManager.VeRosterModel
@{
    ViewData["Title"] = "VE Roster";
    ViewData["ActiveNav"] = "VeRoster";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Volunteer examiners</p>
        <h1>VE Roster</h1>
    </div>
</div>

<form method="get" id="veRosterFilters" class="filters" style="margin-bottom:20px; align-items:flex-start;">
    @* Same team-picker component as the session list. Replaces a <select onchange=submit> that had
       to carry a disabled "Select a team…" placeholder because a null TeamId used to mean "no
       context, show nothing" — it now means "all teams merged", so the placeholder is gone. *@
    @if (Model.AvailableTeams.Count > 1)
    {
        <div class="filter-dropdown">
            <button type="button" class="kebab @(Model.TeamId is not null ? "active" : "")">Team: @Model.TeamSummaryLabel ▾</button>
            <div class="menu">
                <label class="item"><input type="radio" name="teamId" value="" @(Model.TeamId is null ? "checked" : "") /> All teams</label>
                @foreach (var team in Model.AvailableTeams)
                {
                    <label class="item"><input type="radio" name="teamId" value="@team.Id" @(team.Id == Model.TeamId ? "checked" : "") /> @team.Name</label>
                }
                <hr />
                <button type="submit" class="item">Apply</button>
            </div>
        </div>
    }

    <div class="filter-dropdown">
        <button type="button" class="kebab @(Model.DateRangeSummaryLabel != "Any time" ? "active" : "")">Date range: @Model.DateRangeSummaryLabel ▾</button>
        <div class="menu" style="width:240px;">
            <label class="item" style="display:block;">
                <span style="display:block; margin-bottom:4px;">Preset</span>
                <select name="dateRange" class="menu-input">
                    <option value="">Any time</option>
                    @foreach (var preset in VeSessionManager.Web.Pages.SessionManager.IndexModel.DateRangePresets)
                    {
                        <option value="@preset.Key" selected="@(preset.Key == Model.DateRange)">@preset.Value.Label</option>
                    }
                </select>
            </label>
            <hr />
            <div class="item" style="cursor:default;">
                <span style="display:block; margin-bottom:4px;">Custom range (overrides preset)</span>
                <input type="date" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="menu-input" />
                <input type="date" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="menu-input" />
            </div>
            <hr />
            <button type="submit" class="item">Apply</button>
        </div>
    </div>
</form>

@if (!Model.HasTeamContext)
{
    <p>This account isn't assigned to any team yet, so there is nothing to show.</p>
}
else
{
    <div class="table-scroll">
    <table class="cards" data-sortable="ve-roster">
        <thead>
            <tr>
                <th>Call sign</th>
                <th>Name</th>
                @if (Model.AvailableTeams.Count > 1)
                {
                    <th>Team</th>
                }
                <th>Sessions worked</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Counts.Count == 0)
            {
                <tr><td colspan="@(Model.AvailableTeams.Count > 1 ? 4 : 3)">No VE session records in this range.</td></tr>
            }
            @foreach (var count in Model.Counts)
            {
                <tr>
                    <td class="mono">@(count.CallSign ?? "—")</td>
                    <td>@count.Name</td>
                    @if (Model.AvailableTeams.Count > 1)
                    {
                        <td>@count.TeamName</td>
                    }
                    <td class="count">@count.SessionCount</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
