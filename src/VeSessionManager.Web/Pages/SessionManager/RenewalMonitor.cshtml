@page
@using VeSessionManager.Core.Entities
@model VeSessionManager.Web.Pages.SessionManager.RenewalMonitorModel
@{
    ViewData["Title"] = "Renewal Monitor";
    ViewData["ActiveNav"] = "RenewalMonitor";
    Layout = "_AppLayout";
    var utcNow = DateTime.UtcNow;
    var showTeamColumn = Model.TeamId is null && Model.AvailableTeams.Count > 1;
}

<div class="page-head">
    <div>
        <p class="eyebrow">Applicants</p>
        <h1>Renewal Monitor</h1>
    </div>
    <button type="button" class="btn-primary" data-open-modal="addLicenseModal">Watch a license</button>
</div>

@if (Model.AvailableTeams.Count > 1)
{
    <form method="get" class="filters" style="margin-bottom:16px;">
        <partial name="_TeamPicker" model="new VeSessionManager.Web.TeamPicker(Model.TeamId, Model.AvailableTeams, Model.TeamSummaryLabel)" />
    </form>
}

@if (!Model.HasTeamContext)
{
    <p>No team assigned to this account.</p>
}
else
{
    @* Split into "watch list" and "recently renewed" on the same pattern as Applicant Status's
       pending/recently-issued pair — see the RecentlyRenewed doc comment for where the two differ. *@
    <div class="page-head" style="margin-top:8px;">
        <div>
            <h2 style="font-size:16px;">Watch list</h2>
            <p class="eyebrow" style="margin-top:0;">Every license being tracked — moves below once a renewal is issued</p>
        </div>
    </div>

    @* Both treatments, like every other table here: cards below 768px, wrapper scroll above it.
       See docs/responsive-ui.md. *@
    <div class="table-scroll">
    <table class="cards" data-sortable="watched-licenses">
        <thead>
            <tr>
                <th>Call sign</th>
                @* A real column rather than tucked inside the row menu: the FRN is what you paste
                   into FCC's own application search, and copying it should not require opening a
                   dropdown first. *@
                <th>FRN</th>
                <th>Name</th>
                <th>Class</th>
                @if (showTeamColumn)
                {
                    <th>Team</th>
                }
                <th>Expires</th>
                <th>Status</th>
                <th>Renewal</th>
                <th>Note</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Licenses.Count == 0)
            {
                <tr><td colspan="@(showTeamColumn ? 10 : 9)">@(Model.RecentlyRenewed.Count == 0 ? "Nothing on the watch list yet. Add a call sign to start tracking its expiration." : "Nothing waiting — every watched license was renewed recently.")</td></tr>
            }
            @foreach (var row in Model.Licenses)
            {
                var days = row.DaysUntilExpiry(utcNow);
                <tr>
                    <td class="mono session-title">@row.License.CallSign</td>
                    @* select-all on click: an FRN is a 10-digit string with no word boundaries, so
                       double-clicking to select it is fiddly and a mis-copy is silent. *@
                    <td class="mono frn-cell" title="@(row.License.Frn is null ? "No FRN on the FCC record" : "Click to select, for FCC's application search")">@(row.License.Frn ?? "—")</td>
                    <td>@(row.License.LicenseeName ?? "—")</td>
                    <td>@(row.License.OperatorClass == LicenseClass.None ? "—" : row.License.OperatorClass.ToString())</td>
                    @if (showTeamColumn)
                    {
                        <td>@row.License.Team?.Name</td>
                    }
                    <td class="count" data-sort-value="@row.ExpiresSortValue">
                        @row.ExpiresDisplay
                        @if (days is { } d)
                        {
                            @* Escalation reuses the Applicant Status "days pending" pills rather than
                               introducing new colours — already correct in both themes. Applied to a
                               span inside the cell, never the td (see app.css). *@
                            @if (d < 0)
                            {
                                <span class="days-critical" title="Expired @(-d) days ago">@d d</span>
                            }
                            else if (d <= 90)
                            {
                                <span class="days-warning" title="Inside FCC's 90-day renewal window">@d d</span>
                            }
                        }
                    </td>
                    <td><span class="chip @row.Status.ChipClass()">@row.Status.Label()</span></td>
                    <td class="mono">@row.RenewalDisplay</td>
                    <td class="session-sub">@(row.License.Note ?? "")</td>
                    <td class="row-actions">
                        <button type="button" class="kebab" aria-label="Actions"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
                        <div class="menu">
                            @* The rule lives inside the condition — a never-checked row would
                               otherwise open its menu with a stray divider at the top. *@
                            @if (row.License.LastCheckedUtc is { } checkedUtc)
                            {
                                <div class="item session-sub" style="cursor:default;">Checked @checkedUtc.ToString("MMM d, HH:mm") UTC</div>
                                <hr />
                            }
                            <button type="button" class="item danger" data-open-modal="removeLicenseModal-@row.License.Id">Remove from watch list</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <div class="page-head" style="margin-top:28px;">
        <div>
            <h2 style="font-size:16px;">Recently renewed</h2>
            @* States the return, not just the disappearance: unlike a granted candidate on Applicant
               Status, one of these rows has somewhere to go back to. *@
            <p class="eyebrow" style="margin-top:0;">Issued in the last @VeSessionManager.Web.Pages.SessionManager.RenewalMonitorModel.RecentlyRenewedWindowDays days — returns to the watch list after that</p>
        </div>
    </div>
    <div class="table-scroll">
    <table class="cards" data-sortable="recently-renewed">
        <thead>
            <tr>
                <th>Call sign</th>
                <th>FRN</th>
                <th>Name</th>
                <th>Class</th>
                @if (showTeamColumn)
                {
                    <th>Team</th>
                }
                <th>New expiration</th>
                <th>Renewed</th>
                <th>Note</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.RecentlyRenewed.Count == 0)
            {
                <tr><td colspan="@(showTeamColumn ? 9 : 8)">No renewals issued in the last @VeSessionManager.Web.Pages.SessionManager.RenewalMonitorModel.RecentlyRenewedWindowDays days.</td></tr>
            }
            @foreach (var row in Model.RecentlyRenewed)
            {
                <tr>
                    <td class="mono session-title">@row.License.CallSign</td>
                    <td class="mono frn-cell" title="@(row.License.Frn is null ? "No FRN on the FCC record" : "Click to select, for FCC's application search")">@(row.License.Frn ?? "—")</td>
                    <td>@(row.License.LicenseeName ?? "—")</td>
                    <td>@(row.License.OperatorClass == LicenseClass.None ? "—" : row.License.OperatorClass.ToString())</td>
                    @if (showTeamColumn)
                    {
                        <td>@row.License.Team?.Name</td>
                    }
                    @* No day pill here — a freshly renewed license expires ten years out, so the
                       escalation the watch list uses would never fire and only add noise. *@
                    <td class="count" data-sort-value="@row.ExpiresSortValue">@row.ExpiresDisplay</td>
                    <td class="mono" data-sort-value="@row.RenewedSortValue">@row.RenewedDisplay</td>
                    <td class="session-sub">@(row.License.Note ?? "")</td>
                    <td class="row-actions">
                        @* Kept rather than dropped as Applicant Status does: removing a license is this
                           page's one action, and a row sits here for a month. *@
                        <button type="button" class="kebab" aria-label="Actions"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
                        <div class="menu">
                            @if (row.License.LastCheckedUtc is { } checkedUtc)
                            {
                                <div class="item session-sub" style="cursor:default;">Checked @checkedUtc.ToString("MMM d, HH:mm") UTC</div>
                                <hr />
                            }
                            <button type="button" class="item danger" data-open-modal="removeLicenseModal-@row.License.Id">Remove from watch list</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    @* Both tables, so a remove button in either one has its modal. *@
    @foreach (var row in Model.AllRows)
    {
        <div class="modal-backdrop" id="removeLicenseModal-@row.License.Id">
            <div class="modal">
                <h3>Stop watching @row.License.CallSign?</h3>
                <p>This only removes it from your team's watch list. Nothing at FCC is affected.</p>
                <form method="post" asp-page-handler="Remove" asp-route-teamId="@Model.TeamId" asp-antiforgery="true">
                    <input type="hidden" name="watchedLicenseId" value="@row.License.Id" />
                    <div class="modal-actions">
                        <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                        <button type="submit" class="btn-danger btn-sm">Remove</button>
                    </div>
                </form>
            </div>
        </div>
    }
}

<div class="modal-backdrop" id="addLicenseModal">
    <div class="modal">
        <h3>Watch a license</h3>
        <form method="post" asp-page-handler="Add" asp-route-teamId="@Model.TeamId" asp-antiforgery="true">
            @if (Model.AvailableTeams.Count > 1)
            {
                <div class="field">
                    <label for="addTeamId">Team</label>
                    <select id="addTeamId" name="AddTeamId">
                        @foreach (var team in Model.AvailableTeams)
                        {
                            <option value="@team.Id" selected="@(team.Id == Model.AddTeamId)">@team.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="field">
                <label for="addCallSign">Call sign or FRN</label>
                @* autocapitalize/autocorrect matter on a phone, where the soft keyboard would
                   otherwise title-case and autocorrect a call sign into something else entirely. *@
                <input id="addCallSign" name="AddCallSign" required autofocus
                       autocapitalize="characters" autocorrect="off" spellcheck="false"
                       placeholder="W1AW" />
            </div>
            <div class="field">
                <label for="addNote">Note (optional)</label>
                <input id="addNote" name="AddNote" placeholder="Club secretary" />
            </div>
            <p class="session-sub" style="margin:10px 0 0;">Looked up at FCC when you add it, so a typo is caught now rather than showing up as a row that never resolves.</p>
            <div class="modal-actions">
                <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                <button type="submit" class="btn-primary btn-sm">Add</button>
            </div>
        </form>
    </div>
</div>
