@page
@model VeSessionManager.Web.Pages.SessionManager.VeTagsModel
@using VeSessionManager.Core.VolunteerExaminers
@{
    ViewData["Title"] = "VE Tags";
    ViewData["ActiveNav"] = "VeTags";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Volunteer examiners</p>
        <h1>VE Tags</h1>
    </div>
</div>

@if (Model.AvailableTeams.Count > 1)
{
    <form method="get" class="filters" style="margin-bottom:20px;">
        <partial name="_TeamPicker" model="@(new VeSessionManager.Web.TeamPicker(Model.ResolvedTeamId, Model.AvailableTeams, Model.AvailableTeams.FirstOrDefault(t => t.Id == Model.ResolvedTeamId).Name ?? "Choose a team", IncludeAllTeams: false))" />
    </form>
}

@if (Model.ResolvedTeamId is null)
{
    @* A tag belongs to one team's vocabulary, so there is nothing to show or create until one is
       chosen — unlike the directory, which reads perfectly well merged across teams. *@
    <p>Choose a team to manage its VE tags.</p>
}
else
{
    <div class="ve-panel">
        <h2>Tags for this team</h2>
        <p class="session-sub">
            Tags are used for reporting and for choosing who to invite to a session.
            <strong>They grant no access to this app</strong> — a VE tagged "admin" or "session manager"
            has exactly the same access as one with no tag at all. A VE with no tag is treated as a guest.
        </p>

        <div class="table-scroll">
        <table class="cards">
            <thead><tr><th>Name</th><th>Order</th><th>Color</th><th>Discord role</th><th>VEs tagged</th><th></th></tr></thead>
            <tbody>
                @if (Model.Tags.Count == 0)
                {
                    <tr><td colspan="6">No tags yet. Add the ones your team actually uses below.</td></tr>
                }
                @foreach (var row in Model.Tags)
                {
                    var rowColor = VeTagColor.ForStyle(row.Tag.Color);
                    @* Edited in place rather than delete-and-re-add. The tag keeps its id, so every
                       assignment survives by construction — re-adding cascades them away, which made
                       "I want this one listed first" silently untag everyone who had it.

                       The inputs live outside their <form> and are bound to it by form="tag-N".
                       A nested form is invalid HTML and the browser drops it, so the alternative
                       would be one form wrapping the whole row — which cannot also contain the
                       separate Delete form. *@
                    <tr>
                        <td>
                            <input form="tag-@row.Tag.Id" name="name" value="@row.Tag.Name" required
                                   class="menu-input" aria-label="Tag name" />
                        </td>
                        <td>
                            <input form="tag-@row.Tag.Id" name="sortOrder" type="number" value="@row.Tag.SortOrder"
                                   class="menu-input" style="width:80px;" aria-label="Display order" />
                        </td>
                        <td>
                            <span class="color-field">
                                <input form="tag-@row.Tag.Id" name="color" type="color"
                                       value="@(rowColor ?? VeTagsModel.DefaultSwatch)" aria-label="Tag color" />
                                <label class="inline-check">
                                    <input form="tag-@row.Tag.Id" type="checkbox" name="useColor" value="true" @(rowColor is not null ? "checked" : "") />
                                    <span>Use</span>
                                </label>
                            </span>
                        </td>
                        <td>
                            @if (Model.AvailableRoles.Count > 0)
                            {
                                <select form="tag-@row.Tag.Id" name="discordRoleId" class="menu-input" aria-label="Discord role">
                                    <option value="">None</option>
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        <option value="@role.Id" selected="@(role.Id == row.Tag.DiscordRoleId)">@role.Name</option>
                                    }
                                    @* A role that is mapped but no longer in the list — renamed away, deleted, or
                                       simply not visible to the bot — still has to be selectable, or saving the row
                                       for any other reason would silently unmap it. *@
                                    @if (row.Tag.DiscordRoleId is { } mapped && Model.AvailableRoles.All(r => r.Id != mapped))
                                    {
                                        <option value="@mapped" selected>@(row.Tag.DiscordRoleName ?? mapped.ToString()) (not in this server)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input form="tag-@row.Tag.Id" name="discordRoleId" value="@(row.Tag.DiscordRoleId?.ToString())"
                                       class="menu-input" style="width:170px;" aria-label="Discord role id"
                                       placeholder="Role id" />
                            }
                        </td>
                        <td class="count">@row.AssignedCount</td>
                        <td class="row-actions-cell">
                            @* asp-page-handler builds the action from the route only and DROPS the
                               query string, so this posted without teamId and the page 403'd its own
                               form. The hidden field re-supplies it. See CLAUDE.md. *@
                            <form method="post" asp-page-handler="Update" id="tag-@row.Tag.Id">
                                <input type="hidden" name="teamId" value="@Model.ResolvedTeamId" />
                                <input type="hidden" name="tagId" value="@row.Tag.Id" />
                                <button type="submit" class="btn-primary btn-sm">Save</button>
                            </form>
                            <form method="post" asp-page-handler="Delete">
                                <input type="hidden" name="teamId" value="@Model.ResolvedTeamId" />
                                <input type="hidden" name="tagId" value="@row.Tag.Id" />
                                <button type="submit" class="btn-secondary btn-sm"
                                        title="@(row.AssignedCount > 0 ? $"This will also remove the tag from {row.AssignedCount} VE(s)" : null)">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>

    <div class="ve-panel">
        <h2>Add a tag</h2>
        <form method="post" asp-page-handler="Create" class="field-row">
            <input type="hidden" name="teamId" value="@Model.ResolvedTeamId" />
            <div class="field">
                <label for="name">Name</label>
                <input id="name" name="name" required placeholder="e.g. Team member" />
                @* .field-row bottom-aligns its columns (issue #466) so the button lines up with the
                   inputs, not the labels — which only works when every field is the same height.
                   Order and Color both carry a hint line below their input; Name doesn't need one,
                   so it renders an invisible one to match, rather than losing the row's own
                   bottom-alignment for every other field-row on the site. aria-hidden since a blank
                   line has nothing to announce. *@
                <span class="session-sub" aria-hidden="true">&nbsp;</span>
            </div>
            <div class="field">
                <label for="sortOrder">Order</label>
                <input id="sortOrder" name="sortOrder" type="number" value="0" />
                <span class="session-sub">Lower shows first.</span>
            </div>
            <div class="field">
                <label for="color">Color</label>
                <span class="color-field">
                    <input id="color" name="color" type="color" value="@VeTagsModel.DefaultSwatch" />
                    <label class="inline-check"><input type="checkbox" name="useColor" value="true" checked /> <span>Use</span></label>
                </span>
                <span class="session-sub">Color-codes the team on a VE's page.</span>
            </div>
            <div class="field">
                <label for="discordRoleId">Discord role</label>
                @if (Model.AvailableRoles.Count > 0)
                {
                    <select id="discordRoleId" name="discordRoleId">
                        <option value="">None</option>
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    </select>
                }
                else
                {
                    <input id="discordRoleId" name="discordRoleId" placeholder="Role id" />
                }
                <span class="session-sub">Optional. Which role means this tag.</span>
            </div>
            <button type="submit" class="btn-primary btn-sm">Add tag</button>
        </form>
    </div>
}
