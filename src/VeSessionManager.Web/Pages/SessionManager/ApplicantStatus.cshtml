@page
@model VeSessionManager.Web.Pages.SessionManager.ApplicantStatusModel
@using VeSessionManager.Core.Navigation
@{
    ViewData["Title"] = "Applicant Status";
    ViewData["ActiveNav"] = "ApplicantStatus";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Applicants</p>
        <h1>Applicant Status</h1>
    </div>
</div>

@* Same team-picker component as the session list — a radio dropdown inside a GET form, including an
   "All teams" option, rather than the one-team-only pills this page used to have. Counts ride on the
   menu items (rendered even at zero, since comparing teams at a glance is the point) and "All teams"
   carries the total, so the answer to "where is the work?" survives the menu being closed. *@
@if (Model.AvailableTeams.Count > 1)
{
    <form method="get" id="applicantFilters" class="filters" style="margin-bottom:16px; align-items:flex-start;">
        <partial name="_TeamPicker" model="new VeSessionManager.Web.TeamPicker(Model.TeamId, Model.AvailableTeams, Model.TeamSummaryLabel, Counts: Model.PendingCountsByTeam)" />
    </form>
}

@if (!Model.HasTeamContext)
{
    <p>This account isn't assigned to any team yet, so there is nothing to show.</p>
}
else
{
    <div class="page-head" style="margin-top:8px;">
        <div>
            @* Count of exactly what the table below holds, so it answers "how many am I watching?"
               without scrolling or counting rows. Rendered at zero too — same reasoning as the team
               picker's pills: a missing number reads as "not loaded", a muted 0 reads as "none". *@
            <h2 style="font-size:16px;">Pending FCC grant<span class="pill-count @(Model.Pending.Count == 0 ? "zero" : "")">@Model.Pending.Count</span></h2>
            <p class="eyebrow" style="margin-top:0;">Passed but not yet issued — drops off once granted</p>
        </div>
    </div>
    <div class="table-scroll">
    <table class="cards" data-sortable="pending-fcc-grant">
        <thead>
            <tr>
                <th>Candidate</th>
                @if (Model.AvailableTeams.Count > 1)
                {
                    <th>Team</th>
                }
                <th>FRN</th>
                <th>Session</th>
                <th>License class</th>
                <th>Status</th>
                <th>Fee</th>
                <th>Days pending</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Pending.Count == 0)
            {
                <tr><td colspan="@(Model.AvailableTeams.Count > 1 ? 8 : 7)">Nobody is currently waiting on an FCC grant.</td></tr>
            }
            @foreach (var row in Model.Pending)
            {
                <tr>
                    <td><a asp-page="./CandidateDetail" asp-route-id="@row.CandidateId">@row.Name</a></td>
                    @if (Model.AvailableTeams.Count > 1)
                    {
                        <td>@row.TeamName</td>
                    }
                    @* Explicit sort value so the trailing ULS "↗" link text doesn't ride along. *@
                    <td class="mono" data-sort-value="@row.Frn">
                        @row.Frn
                        @if (!string.IsNullOrWhiteSpace(row.LicenseUrl))
                        {
                            <a href="@row.LicenseUrl" target="_blank" rel="noopener"
                               title="This candidate's current FCC license in ULS — for an upgrade, the license they already hold while this exam is still pending"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                        }
                    </td>
                    <td data-sort-value="@row.SessionDateSortValue"><a asp-page="./Detail" asp-route-id="@row.SessionId">@row.SessionDateLine</a></td>
                    <td class="mono">@row.LicenseClassLine</td>
                    <td>@row.StatusLabel</td>
                    <td>@row.FeeLabel</td>
                    @* No day numbers in the tooltip since #401 PR2: the boundaries are this team's own
                       rules now, so naming "day 5" here would be right for one team and wrong for the
                       next. The colour still means the same thing — a boundary this team set has been
                       crossed — and Message Rules is where the number lives. *@
                    <td class="count"><span class="@row.DaysPendingCssClass" title="@(row.DaysPendingCssClass == "days-critical" ? "Past this team's unpaid-payment threshold — the payment link is marked expired and the notice has gone out" : row.DaysPendingCssClass == "days-warning" ? "Past this team's FCC-fee reminder threshold — a reminder has gone to the candidate" : null)">@(row.DaysPending?.ToString() ?? "—")</span></td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <div class="page-head" style="margin-top:28px;">
        <div>
            <h2 style="font-size:16px;">Recently issued</h2>
            <p class="eyebrow" style="margin-top:0;">Granted in the last @VeSessionManager.Web.Pages.SessionManager.ApplicantStatusModel.RecentlyIssuedWindowDays days</p>
        </div>
    </div>
    <div class="table-scroll">
    <table class="cards" data-sortable="recently-issued">
        <thead>
            <tr>
                <th>Candidate</th>
                @if (Model.AvailableTeams.Count > 1)
                {
                    <th>Team</th>
                }
                <th>Session</th>
                <th>Call sign</th>
                <th>License class</th>
                <th>Granted</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.RecentlyIssued.Count == 0)
            {
                <tr><td colspan="@(Model.AvailableTeams.Count > 1 ? 6 : 5)">No grants in the last @VeSessionManager.Web.Pages.SessionManager.ApplicantStatusModel.RecentlyIssuedWindowDays days.</td></tr>
            }
            @foreach (var row in Model.RecentlyIssued)
            {
                <tr>
                    <td><a asp-page="./CandidateDetail" asp-route-id="@row.CandidateId">@row.Name</a></td>
                    @if (Model.AvailableTeams.Count > 1)
                    {
                        <td>@row.TeamName</td>
                    }
                    <td data-sort-value="@row.SessionDateSortValue"><a asp-page="./Detail" asp-route-id="@row.SessionId">@row.SessionDateLine</a></td>
                    @* Explicit sort value so the trailing ULS "↗" link text doesn't ride along. *@
                    <td class="mono" data-sort-value="@row.CallSign">
                        @row.CallSign
                        @if (!string.IsNullOrWhiteSpace(row.LicenseUrl))
                        {
                            <a href="@row.LicenseUrl" target="_blank" rel="noopener" title="This license in FCC ULS"><i class="bi bi-arrow-up-right" aria-hidden="true"></i></a>
                        }
                    </td>
                    <td class="mono">@row.LicenseClassLine</td>
                    <td class="mono" data-sort-value="@row.GrantDateSortValue">@row.GrantDateLine</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
