@page
@model VeSessionManager.Web.Pages.SessionManager.ApplicantStatusModel
@using VeSessionManager.Core.Navigation
@{
    ViewData["Title"] = "Applicant Status";
    ViewData["ActiveNav"] = "ApplicantStatus";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Applicants</p>
        <h1>Applicant Status</h1>
    </div>
</div>

@if (Model.AvailableTeams.Count > 1)
{
    <div class="filters" style="margin-bottom:16px;">
        @foreach (var team in Model.AvailableTeams)
        {
            @* Count is rendered even at zero (unlike the nav badge, which hides) — the point of the
               picker is comparing teams at a glance, and "0" is the useful answer for "do I need to
               look here?". .pill-count.zero mutes it so a busy team still stands out. *@
            <a class="filter-pill @(team.Id == Model.TeamId ? "active" : "")" asp-page="./ApplicantStatus" asp-route-teamId="@team.Id">
                @team.Name<span class="pill-count @(Model.PendingCountsByTeam.CountFor(team.Id) == 0 ? "zero" : "")">@Model.PendingCountsByTeam.CountFor(team.Id)</span>
            </a>
        }
    </div>
}

@if (!Model.HasTeamContext)
{
    <p>No team context for this account — applicant status is per-team.</p>
}
else
{
    <div class="page-head" style="margin-top:8px;">
        <div>
            <h2 style="font-size:16px;">Pending FCC grant</h2>
            <p class="eyebrow" style="margin-top:0;">Passed but not yet issued — drops off once granted</p>
        </div>
    </div>
    <table>
        <thead>
            <tr>
                <th>Candidate</th>
                <th>FRN</th>
                <th>Session</th>
                <th>License class</th>
                <th>Status</th>
                <th>Fee</th>
                <th>Days pending</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Pending.Count == 0)
            {
                <tr><td colspan="7">Nobody is currently waiting on an FCC grant.</td></tr>
            }
            @foreach (var row in Model.Pending)
            {
                <tr>
                    <td><a asp-page="./CandidateDetail" asp-route-id="@row.CandidateId">@row.Name</a></td>
                    <td class="mono">@row.Frn</td>
                    <td><a asp-page="./Detail" asp-route-id="@row.SessionId">@row.SessionDateLine</a></td>
                    <td class="mono">@row.LicenseClassLine</td>
                    <td>@row.StatusLabel</td>
                    <td>@row.FeeLabel</td>
                    <td class="count">@row.DaysPending</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="page-head" style="margin-top:28px;">
        <div>
            <h2 style="font-size:16px;">Recently issued</h2>
            <p class="eyebrow" style="margin-top:0;">Granted in the last @VeSessionManager.Web.Pages.SessionManager.ApplicantStatusModel.RecentlyIssuedWindowDays days</p>
        </div>
    </div>
    <table>
        <thead>
            <tr>
                <th>Candidate</th>
                <th>Session</th>
                <th>Call sign</th>
                <th>License class</th>
                <th>Granted</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.RecentlyIssued.Count == 0)
            {
                <tr><td colspan="5">No grants in the last @VeSessionManager.Web.Pages.SessionManager.ApplicantStatusModel.RecentlyIssuedWindowDays days.</td></tr>
            }
            @foreach (var row in Model.RecentlyIssued)
            {
                <tr>
                    <td><a asp-page="./CandidateDetail" asp-route-id="@row.CandidateId">@row.Name</a></td>
                    <td><a asp-page="./Detail" asp-route-id="@row.SessionId">@row.SessionDateLine</a></td>
                    <td class="mono">@row.CallSign</td>
                    <td class="mono">@row.LicenseClassLine</td>
                    <td class="mono">@row.GrantDateLine</td>
                </tr>
            }
        </tbody>
    </table>
}
