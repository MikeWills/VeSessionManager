@page
@model VeSessionManager.Web.Pages.SessionManager.UnmatchedPaymentsModel
@using VeSessionManager.Core.Navigation
@{
    ViewData["Title"] = "Unmatched Payments";
    ViewData["ActiveNav"] = "UnmatchedPayments";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">@Model.UnmatchedPayments.Count @(Model.ShowDismissed ? "dismissed" : "awaiting match")</p>
        <h1>Unmatched Payments</h1>
    </div>
    <div class="row-actions">
        <a class="btn-secondary btn-sm" asp-route-teamId="@Model.TeamId" asp-route-showDismissed="@(Model.ShowDismissed ? null : "true")">
            @(Model.ShowDismissed ? "Back to awaiting match" : "View dismissed")
        </a>
    </div>
</div>

@* Same team-picker component as the session list — see the equivalent comment in ApplicantStatus.cshtml. *@
@if (Model.AvailableTeams.Count > 1)
{
    <form method="get" id="unmatchedFilters" class="filters" style="margin-bottom:16px; align-items:flex-start;">
        <partial name="_TeamPicker" model="new VeSessionManager.Web.TeamPicker(Model.TeamId, Model.AvailableTeams, Model.TeamSummaryLabel, Counts: Model.UnmatchedCountsByTeam)" />
    </form>
}

@if (!Model.HasTeamContext)
{
    <p>No team context for this account — unmatched payments are tracked per-team.</p>
}
else
{
    @if (Model.ShowDismissed)
    {
        <p class="session-sub">Payments resolved by dismissing them rather than matching them to a candidate. They are kept for reconciliation — the money is still in Square, exactly as it was.</p>
    }
    else
    {
        <p class="session-sub">Square payments that arrived but couldn't be matched to a candidate automatically — usually a payment taken through a separate online payment page rather than one of this app's own generated links. Pick the right candidate below to mark their outstanding payment paid, or dismiss it if no candidate owes it.</p>
    }

    <div class="table-scroll">
    <table class="cards" data-sortable="unmatched-payments">
        <thead>
            <tr>
                <th>Received</th>
                @if (Model.AvailableTeams.Count > 1)
                {
                    <th>Team</th>
                }
                <th>Amount</th>
                <th>Buyer email</th>
                <th>Square order</th>
                @if (Model.ShowDismissed)
                {
                    <th>Dismissed</th>
                    <th>Reason</th>
                }
                else
                {
                    @* The match column is a per-row <select>+button, not a value — nothing to order by. *@
                    <th data-sort="none">Match to candidate</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.UnmatchedPayments.Count == 0)
            {
                var emptyColumns = (Model.AvailableTeams.Count > 1 ? 5 : 4) + (Model.ShowDismissed ? 2 : 1);
                <tr><td colspan="@emptyColumns">@(Model.ShowDismissed ? "Nothing has been dismissed." : "Nothing waiting on a match.")</td></tr>
            }
            @foreach (var payment in Model.UnmatchedPayments)
            {
                <tr>
                    <td data-sort-value="@payment.ReceivedSortValue">@payment.ReceivedLine</td>
                    @if (Model.AvailableTeams.Count > 1)
                    {
                        <td>@payment.TeamName</td>
                    }
                    <td>@Usd.Format(payment.AmountUsd)</td>
                    <td>@(payment.BuyerEmailAddress ?? "—")</td>
                    <td><span class="session-sub">@payment.SquareOrderId</span></td>
                    @if (Model.ShowDismissed)
                    {
                        <td>@payment.DismissedLine<br /><span class="session-sub">by @(payment.DismissedByName ?? "—")</span></td>
                        <td>@(payment.ResolutionNote ?? "—")</td>
                    }
                    else
                    {
                        <td class="row-actions" style="text-align:left;">
                            @* Same-team candidates only — with "All teams" the page shows several teams
                               at once, and matching Team A's money to Team B's candidate must not be
                               offerable. OnPostMatchAsync enforces the same rule server-side. *@
                            @{ var matchable = Model.MatchableCandidates.Where(c => c.TeamId == payment.TeamId).ToList(); }
                            @if (matchable.Count == 0)
                            {
                                <span class="session-sub">No candidates with an outstanding unpaid payment.</span>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Match" style="display:flex; gap:8px; align-items:center;">
                                    @* Same team-filter-through-POST reason as Admin/Users — see the note there. *@
                                    <input type="hidden" name="teamId" value="@Model.TeamId" />
                                    <input type="hidden" name="unmatchedPaymentId" value="@payment.Id" />
                                    <select name="candidateId" required class="menu-input">
                                        <option value="">Select candidate…</option>
                                        @foreach (var candidate in matchable)
                                        {
                                            <option value="@candidate.Id">@candidate.Name — @candidate.SessionDateLine (@Usd.Format(candidate.AmountOwed))</option>
                                        }
                                    </select>
                                    <button type="submit" class="btn-secondary btn-sm">Match</button>
                                </form>
                            }
                            @* Offered whether or not there is a matchable candidate, and especially when
                               there isn't: a payment with nobody to match it to is the main thing this
                               button exists for. *@
                            <button type="button" class="btn-secondary btn-sm" data-open-modal="dismissModal-@payment.Id">Dismiss</button>
                            @* #375. Offered only where Square would actually accept it — over a year
                               old, or already refunded, and the button would only produce an error. *@
                            @if (payment.Refundability.CanRefund)
                            {
                                <button type="button" class="btn-secondary btn-sm" data-open-modal="refundModal-@payment.Id">Refund and dismiss…</button>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    </div>

    @* One modal per row rather than one shared modal whose fields get rewritten by script: the CSP is
       script-src 'self', and app.js's modal handling only opens and closes — it has no notion of
       populating one. Same shape as Admin/Users' per-row call-sign modal. *@
    @if (!Model.ShowDismissed)
    {
        @foreach (var payment in Model.UnmatchedPayments)
        {
            <div class="modal-backdrop" id="dismissModal-@payment.Id">
                <div class="modal">
                    <h3>Dismiss @Usd.Format(payment.AmountUsd)?</h3>
                    <form method="post" asp-page-handler="Dismiss">
                        <input type="hidden" name="teamId" value="@Model.TeamId" />
                        <input type="hidden" name="unmatchedPaymentId" value="@payment.Id" />
                        <p class="session-sub">
                            Square order <span class="mono">@payment.SquareOrderId</span>, received @payment.ReceivedLine@(payment.BuyerEmailAddress is null ? "" : $" from {payment.BuyerEmailAddress}").
                        </p>
                        @* The bold half of this warning is the reason #375 exists — #99 had to write
                           it because there was no alternative to point at. There is one now, so the
                           sentence names it instead of leaving the user at a dead end. It stays bold:
                           "dismiss" is still the one word here that could be read as "send it back". *@
                        <p>
                            <strong>This clears it from this screen only. It does not refund the payment in Square</strong> —
                            the money stays exactly where it is.@(payment.Refundability.CanRefund ? " Use \"Refund and dismiss\" if you want it sent back." : "")
                            Dismiss it when nobody owes it: a test charge, a donation, a duplicate of something
                            already recorded, or a refund you have already handled in Square yourself.
                        </p>
                        <div class="field">
                            <label for="dismissReason-@payment.Id">Reason (optional)</label>
                            <input id="dismissReason-@payment.Id" name="reason" maxlength="500" placeholder="e.g. duplicate of order abc123" />
                        </div>
                        <div class="modal-actions">
                            <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                            <button type="submit" class="btn-primary btn-sm">Dismiss payment</button>
                        </div>
                    </form>
                </div>
            </div>

            @if (payment.Refundability.CanRefund)
            {
                <div class="modal-backdrop" id="refundModal-@payment.Id">
                    <div class="modal">
                        <h3>Refund @Usd.Format(payment.Refundability.RemainingUsd)?</h3>
                        <form method="post" asp-page-handler="RefundAndDismiss">
                            <input type="hidden" name="teamId" value="@Model.TeamId" />
                            <input type="hidden" name="unmatchedPaymentId" value="@payment.Id" />
                            <p class="session-sub">
                                Square order <span class="mono">@payment.SquareOrderId</span>, received @payment.ReceivedLine@(payment.BuyerEmailAddress is null ? "" : $" from {payment.BuyerEmailAddress}").
                            </p>
                            <p>
                                <strong>This sends the money back through Square and cannot be undone from here.</strong>
                                The row is dismissed from this screen once the refund goes through — and left alone if it doesn't.
                            </p>
                            <div class="field">
                                <label for="refundAmount-@payment.Id">Amount to refund</label>
                                <input id="refundAmount-@payment.Id" name="amount" type="number" step="0.01" min="0.01"
                                       max="@payment.RefundableRaw" value="@payment.RefundableRaw" required />
                            </div>
                            <div class="field">
                                <label for="refundReason-@payment.Id">Reason (optional)</label>
                                <input id="refundReason-@payment.Id" name="reason" maxlength="192" placeholder="e.g. paid twice" />
                                <span class="session-sub">Shown in the Square dashboard as well as here.</span>
                            </div>
                            <div class="modal-actions">
                                <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                                <button type="submit" class="btn-primary btn-sm">Refund and dismiss</button>
                            </div>
                        </form>
                    </div>
                </div>
            }
        }
    }
}
