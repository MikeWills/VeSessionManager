@page
@using VeSessionManager.Core.Entities
@model VeSessionManager.Web.Pages.SessionManager.VeDirectoryModel
@using VeSessionManager.Core.VolunteerExaminers
@{
    ViewData["Title"] = "VE Directory";
    ViewData["ActiveNav"] = "VeDirectory";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Volunteer examiners</p>
        <h1>VE Directory</h1>
    </div>
    @* Carries the current filters, so the file matches the list on screen rather than silently
       exporting everything. *@
    @* Export-what-you-see: every filter, or the file and the screen disagree about who is on it. *@
    @* A POST, not a link: the export writes an audit row attesting that PII left the building, and
       as a GET any cross-site <img> could forge that entry (#265/L-11).

       asp-all-route-data carries the filters into the generated action, so this does NOT hit the
       "asp-page-handler drops the query string" trap CLAUDE.md records — the filters are supplied
       explicitly rather than inherited from the current URL. And because the tag helper generates
       the action itself, it emits the antiforgery token automatically; an explicit action= would
       silently drop it. *@
    <form method="post" asp-page-handler="Export" asp-all-route-data="@Model.FilterRoute" class="inline-form">
        <button type="submit" class="btn-secondary btn-sm">Export CSV</button>
    </form>
</div>

<form method="get" class="filters" style="margin-bottom:20px; align-items:flex-start;">
    @if (Model.AvailableTeams.Count > 1)
    {
        <div class="filter-dropdown">
            <button type="button" class="kebab @(Model.TeamId is not null ? "active" : "")">Team: @Model.TeamSummaryLabel <i class="bi bi-caret-down-fill" aria-hidden="true"></i></button>
            <div class="menu">
                <label class="item"><input type="radio" name="teamId" value="" @(Model.TeamId is null ? "checked" : "") /> All teams</label>
                @foreach (var team in Model.AvailableTeams)
                {
                    <label class="item"><input type="radio" name="teamId" value="@team.Id" @(team.Id == Model.TeamId ? "checked" : "") /> @team.Name</label>
                }
                <hr />
                <button type="submit" class="item">Apply</button>
                @* Straight to the tag vocabulary for whichever team is selected — the directory is
                   where someone notices a tag is missing or misnamed. Omitted on "all teams", where
                   there is no single vocabulary to edit. *@
                @if (Model.TeamId is { } selectedTeamId)
                {
                    <a class="item" asp-page="/SessionManager/VeTags" asp-route-teamId="@selectedTeamId">Manage this team's tags</a>
                }
            </div>
        </div>
    }

    <label class="ve-search">
        <span class="visually-hidden">Search by call sign, name or email</span>
        <i class="bi bi-search" aria-hidden="true"></i>
        <input type="search" name="search" value="@Model.Search" placeholder="Call sign, name or email" />
    </label>

    @if (Model.AvailableTags.Count > 0)
    {
        var activeTag = Model.AvailableTags.FirstOrDefault(t => string.Equals(t.Name, Model.TagName, StringComparison.OrdinalIgnoreCase));
        var tagLabel = Model.IsGuestFilter ? "Guests" : activeTag?.Name ?? "Any";
        <div class="filter-dropdown">
            <button type="button" class="kebab @(Model.TagName is not null ? "active" : "")">Tag: @tagLabel <i class="bi bi-caret-down-fill" aria-hidden="true"></i></button>
            <div class="menu">
                <label class="item"><input type="radio" name="tagName" value="" @(Model.TagName is null ? "checked" : "") /> Any tag</label>
                @* Guests are people with no tag at all, which is derived rather than stored — so it
                   cannot be one of the names below and takes a sentinel value instead. *@
                <label class="item">
                    <input type="radio" name="tagName" value="@VolunteerExaminerDirectoryService.GuestTagFilter"
                           @(Model.IsGuestFilter ? "checked" : "") />
                    Guests (no tags)
                </label>
                @* One entry per distinct NAME. Two teams both defining "Member" used to produce two
                   identical radio buttons, and picking either hid the other team's people. *@
                @foreach (var tag in Model.AvailableTags)
                {
                    var optionColor = VeTagColor.ForStyle(tag.Color);
                    <label class="item">
                        <input type="radio" name="tagName" value="@tag.Name" @(string.Equals(tag.Name, Model.TagName, StringComparison.OrdinalIgnoreCase) ? "checked" : "") />
                        <span class="tag-label @(optionColor is null ? null : "has-color")"
                              style="@(optionColor is null ? null : $"--tag-color: {optionColor};")">@tag.Name</span>
                    </label>
                }
                <hr />
                <button type="submit" class="item">Apply</button>
            </div>
        </div>
    }

    @* Retired memberships are hidden by default: the directory answers "who can we call on", and a
       list that keeps everyone who ever served stops being that. *@
    <div class="filter-dropdown">
        <button type="button" class="kebab @(Model.LicenseStatus is not null ? "active" : "")">License: @(Model.LicenseStatus?.Label() ?? "Any") <i class="bi bi-caret-down-fill" aria-hidden="true"></i></button>
        <div class="menu">
            <label class="item"><input type="radio" name="licenseStatus" value="" @(Model.LicenseStatus is null ? "checked" : "") /> Any status</label>
            @foreach (var status in VeDirectoryModel.LicenseStatuses)
            {
                <label class="item">
                    <input type="radio" name="licenseStatus" value="@status" @(Model.LicenseStatus == status ? "checked" : "") />
                    @status.Label()
                </label>
            }
            <hr />
            <button type="submit" class="item">Apply</button>
        </div>
    </div>

    @* "Over a year ago" is an upper bound where the others are lower bounds — it is the one anyone
       actually reaches for, since it answers "who has gone quiet". A VE with no last-worked date at
       all matches none of these: both readings are claims about a date that does not exist. *@
    <div class="filter-dropdown">
        <button type="button" class="kebab @(Model.Worked is not null ? "active" : "")">Worked: @VeDirectoryFilterRoute.Label(Model.Worked) <i class="bi bi-caret-down-fill" aria-hidden="true"></i></button>
        <div class="menu">
            <label class="item"><input type="radio" name="worked" value="" @(Model.Worked is null ? "checked" : "") /> Any time</label>
            <label class="item"><input type="radio" name="worked" value="@VeDirectoryFilterRoute.Last3Months" @(Model.Worked == VeDirectoryFilterRoute.Last3Months ? "checked" : "") /> Last 3 months</label>
            <label class="item"><input type="radio" name="worked" value="@VeDirectoryFilterRoute.Last6Months" @(Model.Worked == VeDirectoryFilterRoute.Last6Months ? "checked" : "") /> Last 6 months</label>
            <label class="item"><input type="radio" name="worked" value="@VeDirectoryFilterRoute.LastYear" @(Model.Worked == VeDirectoryFilterRoute.LastYear ? "checked" : "") /> Last year</label>
            <label class="item"><input type="radio" name="worked" value="@VeDirectoryFilterRoute.OverAYear" @(Model.Worked == VeDirectoryFilterRoute.OverAYear ? "checked" : "") /> Over a year ago</label>
            <hr />
            <label class="item"><input type="radio" name="worked" value="@VeDirectoryFilterRoute.Custom" @(Model.Worked == VeDirectoryFilterRoute.Custom ? "checked" : "") /> Custom range</label>
            <label class="item">From <input type="date" name="workedFrom" value="@Model.WorkedFrom?.ToString("yyyy-MM-dd")" class="menu-input" /></label>
            <label class="item">To <input type="date" name="workedTo" value="@Model.WorkedTo?.ToString("yyyy-MM-dd")" class="menu-input" /></label>
            <hr />
            <button type="submit" class="item">Apply</button>
        </div>
    </div>

    <label class="toggle-pill @(Model.IncludeInactive ? "active" : "")">
        <input type="checkbox" name="includeInactive" value="true" data-autosubmit @(Model.IncludeInactive ? "checked" : "") />
        <span>Show retired</span>
    </label>
</form>

@if (!Model.HasTeamContext)
{
    <p>This account isn't assigned to any team yet, so there is nothing to show.</p>
}
else
{
@* Adding a VE by hand covers the one person ExamTools can never supply: a prospect the team is
   watching who has not worked a session yet. Everyone else arrives through ingestion. *@
<details class="ve-add">
    <summary>Add a VE</summary>
    <p class="session-sub">
        For someone your team is watching who hasn't worked a session yet — VEs who have appear here
        on their own. If they already exist on another team, they'll be added to this one rather than
        duplicated.
    </p>
    @* The explicit action carries the filters through the POST, which asp-page-handler cannot: it
       builds the action from the route alone and drops the query string. It must therefore be the
       ONLY routing attribute here — FormTagHelper throws outright if an explicit action= sits
       beside asp-page-handler, and the handler name is already in the Url.Page call. The
       asp-antiforgery is the other half of the pair: with an explicit action the tag helper stops
       emitting the token by itself, and every POST then 400s in middleware with no server-side log.
       Both halves are documented in CLAUDE.md. *@
    <form method="post" asp-antiforgery="true"
          action="@Url.Page("/SessionManager/VeDirectory", "Add", Model.FilterRoute)"
          class="field-row">
        <div class="field">
            <label for="addTeamId">Team</label>
            <select id="addTeamId" name="addTeamId" class="filter-select" required>
                @foreach (var team in Model.AvailableTeams)
                {
                    <option value="@team.Id" selected="@(team.Id == Model.TeamId)">@team.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="addCallSign">Call sign</label>
            <input id="addCallSign" name="callSign" class="menu-input" />
        </div>
        <div class="field">
            <label for="addName">Name</label>
            <input id="addName" name="name" class="menu-input" />
        </div>
        <div class="field">
            <label for="addEmail">Email</label>
            <input id="addEmail" name="email" type="email" class="menu-input" />
        </div>
        <div class="field">
            <label for="addPhone">Phone</label>
            <input id="addPhone" name="phone" class="menu-input" />
        </div>
        <button type="submit" class="btn-primary btn-sm">Add VE</button>
    </form>
</details>

<div class="table-scroll">
    <table class="cards" data-sortable="ve-directory">
        <thead>
            <tr>
                <th>Call sign</th>
                <th>Name</th>
                <th>Teams</th>
                <th>Tags</th>
                <th>License</th>
                <th>Last worked</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Count == 0)
            {
                <tr><td colspan="7">
                    @(string.IsNullOrWhiteSpace(Model.Search)
                        ? "No VEs on this team's directory yet. They appear automatically once they work a session."
                        : $"No VEs match \"{Model.Search}\".")
                </td></tr>
            }
            @foreach (var row in Model.Rows)
            {
                <tr class="@(row.IsActive ? "" : "muted-row")">
                    <td class="mono">
                        @(row.VolunteerExaminer.CallSign ?? "—")
                        @if (row.HasDuplicateCallSign)
                        {
                            @* Left unmerged by the phase 1 migration because the names disagreed —
                               possibly one person, possibly a reissued call sign. A human decides. *@
                            <a asp-page="/SessionManager/VeMerge" asp-route-id="@row.VolunteerExaminer.Id"
                               title="Another VE record shares this call sign — possibly the same person">
                                <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                <span class="visually-hidden">Review possible duplicate</span>
                            </a>
                        }
                    </td>
                    <td><a asp-page="/SessionManager/VeDetail" asp-all-route-data="@Model.DetailRoute(row.VolunteerExaminer.Id)">@row.VolunteerExaminer.Name</a></td>
                    <td>@row.TeamSummary</td>
                    <td>
                        @if (row.IsGuest)
                        {
                            <span class="chip chip-neutral">Guest</span>
                        }
                        else
                        {
                            @foreach (var tag in row.Tags)
                            {
                                @* A tint rather than a flood: the background is the chosen colour at
                                   low opacity and only the dot is full strength, so the label stays
                                   legible whatever anyone picks. Flooding the chip would need
                                   luminance maths to decide the text colour, and that gets it wrong
                                   at the edges. ForStyle re-validates — see VeTagColor. *@
                                var tagColor = VeTagColor.ForStyle(tag.Color);
                                <span class="chip @(tagColor is null ? "chip-neutral" : "chip-tag")"
                                      style="@(tagColor is null ? null : $"--tag-color: {tagColor};")">@tag.Name</span>
                            }
                        }
                        @if (!row.IsActive)
                        {
                            @* Retired everywhere in scope. A VE retired from one team but serving
                               another is still someone this deployment can call on, so the per-team
                               state shows in the Teams column instead. *@
                            <span class="chip chip-brick">Retired</span>
                        }
                    </td>
                    @{
                        var licenseStatus = row.VolunteerExaminer.DeriveSnapshotStatus(Model.UtcNow);
                        var expiryDays = WatchedLicenseStatusExtensions.DaysUntil(row.VolunteerExaminer.LicenseExpiresUtc, Model.UtcNow);
                    }
                    <td data-sort-value="@(row.VolunteerExaminer.LicenseExpiresUtc?.ToString("o") ?? "")">
                        <span class="chip @licenseStatus.ChipClass()">@licenseStatus.Label()</span>
                        @if (row.VolunteerExaminer.LicenseExpiresUtc is { } expires)
                        {
                            <span class="session-sub">@expires.ToString("MMM yyyy")@(expiryDays is { } d && d <= 90 ? $" ({d} d)" : "")</span>
                        }
                    </td>
                    <td data-sort-value="@(row.LastWorkedUtc?.ToString("o") ?? "")">
                        @(row.LastWorkedUtc?.ToString("MMM d, yyyy") ?? "Never")
                    </td>
                    <td><a asp-page="/SessionManager/VeDetail" asp-all-route-data="@Model.DetailRoute(row.VolunteerExaminer.Id)">Manage</a></td>
                </tr>
            }
        </tbody>
    </table>
    </div>

    <p class="session-sub" style="margin-top:12px;">
        Tags are for reporting only and grant no access to this app.
        A VE with no tag is treated as a guest.
        The CSV export includes home addresses and phone numbers, and is recorded in the audit log.
    </p>
}
