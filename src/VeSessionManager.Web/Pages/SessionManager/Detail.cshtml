@page "{id:int}"
@model VeSessionManager.Web.Pages.SessionManager.DetailModel
@{
    ViewData["Title"] = Model.Session.BreadcrumbLabel;
    ViewData["ActiveNav"] = "Sessions";
    ViewData["WideMain"] = true;
    Layout = "_AppLayout";
}

<div class="crumb"><a asp-page="./Index">← Sessions</a> / @Model.Session.BreadcrumbLabel</div>

@if (Model.Session.RescheduleFlagged)
{
    <div class="flag-banner">
        <span>⚑</span>
        <span><b>Reschedule flagged for review</b> — this session's date changed while candidates were already registered.</span>
        @if (Model.CanEdit)
        {
            <form method="post" asp-page-handler="ClearFlag">
                <button type="submit" class="btn-secondary btn-sm">Clear flag</button>
            </form>
        }
    </div>
}

<div class="session-panel">
    <div>
        <h1>@Model.Session.Heading</h1>
        <div class="meta-grid">
            <div class="meta-item"><span class="k">VEC</span><span class="v">@Model.Session.VecName</span></div>
            <div class="meta-item">
                <span class="k">Zoom</span>
                <span class="v">
                    @if (Model.Session.ZoomJoinUrl is not null)
                    {
                        <a href="@Model.Session.ZoomJoinUrl" target="_blank" rel="noopener">Join link ↗</a>
                    }
                    else
                    {
                        <text>—</text>
                    }
                </span>
            </div>
            <div class="meta-item">
                <span class="k">Discord event</span>
                <span class="v">
                    @if (Model.Session.DiscordEventUrl is not null)
                    {
                        <a href="@Model.Session.DiscordEventUrl" target="_blank" rel="noopener">View ↗</a>
                    }
                    else
                    {
                        <text>—</text>
                    }
                </span>
            </div>
            <div class="meta-item"><span class="k">Fee</span><span class="v mono">@Model.Session.FeeLine</span></div>
            <div class="meta-item"><span class="k">Total collected</span><span class="v mono">@Model.Session.TotalCollectedLine</span></div>
            <div class="meta-item">
                <span class="k">Total retained</span>
                <span class="v mono">
                    @Model.Session.TotalRetainedLine
                    @if (Model.Session.RetainedAmountOverridden)
                    {
                        <span class="chip chip-amber" style="margin-left:6px;">Overridden</span>
                    }
                    @if (Model.CanEdit)
                    {
                        <button type="button" class="btn-secondary btn-sm" style="margin-left:6px;" data-open-modal="retainedAmountOverrideModal">Edit</button>
                    }
                </span>
            </div>
            <div class="meta-item"><span class="k">Remit to VEC</span><span class="v mono">@Model.Session.TotalRemitToVecLine</span></div>
            <div class="meta-item"><span class="k">Testing status</span><span class="v">@Model.Session.TestingStatusLine</span></div>
            <div class="meta-item">
                <span class="k">VEC submission</span>
                <span class="v">
                    <span class="chip @Model.Session.VecSubmissionChipClass">@Model.Session.VecSubmissionChipLabel</span>
                    @if (!Model.Session.VecSubmitted && Model.CanEdit)
                    {
                        <form method="post" asp-page-handler="ToggleVecSubmission" style="display:inline">
                            <button type="submit" class="btn-secondary btn-sm">Mark submitted</button>
                        </form>
                    }
                </span>
            </div>
        </div>
    </div>
    <div class="panel-actions">
        @if (!Model.Session.TestingCompleted && !Model.Session.Cancelled && Model.CanEdit)
        {
            <form method="post" asp-page-handler="MarkCompleted">
                <button type="submit" class="btn-primary">Mark session completed</button>
            </form>
        }
        @if (Model.CanDeleteSession)
        {
            <button type="button" class="btn-danger" data-open-modal="deleteSessionModal">Delete session</button>
        }
    </div>
</div>

<div class="section-head">
    <div>
        <p class="eyebrow">@Model.Candidates.Count candidates</p>
        <h2>Candidate roster</h2>
    </div>
    @if (Model.CanEdit)
    {
        <form method="post" asp-page-handler="RefreshCandidates">
            <button type="submit" class="btn-secondary btn-sm">↻ Refresh candidates</button>
        </form>
    }
</div>

<table>
    <thead>
        <tr>
            <th>Candidate</th>
            <th>Application status</th>
            <th>Payment</th>
            <th>Tested</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Candidates.Count == 0)
        {
            <tr><td colspan="5">No candidates registered for this session yet.</td></tr>
        }
        @foreach (var candidate in Model.Candidates)
        {
            <tr>
                <td>
                    <div class="cand-name">
                        @if (candidate.IsWithdrawn)
                        {
                            <span class="no-show">@candidate.DisplayName</span>
                        }
                        else
                        {
                            <a asp-page="./CandidateDetail" asp-route-id="@candidate.Id">@candidate.DisplayName</a>
                        }
                    </div>
                    <div class="id-cell mono">@candidate.CallSignOrDash <span class="frn">@candidate.FrnLine</span></div>
                </td>
                <td>
                    <div class="status-row">
                        <div class="meter">
                            @foreach (var seg in candidate.MeterSegments)
                            {
                                <div class="seg @seg"></div>
                            }
                        </div>
                        <span class="status-label">@candidate.StatusLabel</span>
                    </div>
                </td>
                <td>
                    <span class="chip @candidate.PaymentChipClass">@candidate.PaymentChipLabel</span>
                    @if (candidate.RefundRequested)
                    {
                        <span class="refund-tag">Refund requested</span>
                    }
                    @if (candidate.AmountMismatchLine is not null)
                    {
                        <span class="mismatch-tag" title="Matched via Square anyway — this team's real-world payments don't always equal the amount owed (e.g. the ARRL youth rate) until confirmed at test time.">@candidate.AmountMismatchLine</span>
                    }
                </td>
                <td><span class="tested-check @(candidate.Tested ? "on" : "")">@(candidate.Tested ? "✓" : "·")</span></td>
                <td class="row-actions">
                    @if (!Model.CanEdit)
                    {
                        <!-- read-only view (e.g. TeamLead) — no actions -->
                    }
                    else if (candidate.IsWithdrawn)
                    {
                        <button class="kebab" disabled style="opacity:.35">⋮</button>
                    }
                    else
                    {
                        <button type="button" class="kebab">⋮</button>
                        <div class="menu">
                            <button type="button" class="item" data-open-modal="emailHistoryModal-@candidate.Id">Email history</button>
                            <form method="post" asp-page-handler="ResendConfirmation">
                                <input type="hidden" name="candidateId" value="@candidate.Id" />
                                <button type="submit" class="item" disabled="@(!candidate.CanResendConfirmation)">Resend confirmation email</button>
                            </form>
                            <form method="post" asp-page-handler="MarkPaid">
                                <input type="hidden" name="paymentId" value="@candidate.PrimaryPaymentId" />
                                <button type="submit" class="item" disabled="@(!candidate.CanMarkPaid)">Mark paid manually</button>
                            </form>
                            <button type="button" class="item" data-open-modal="frnModal-@candidate.Id">Add / edit FRN</button>
                            <hr>
                            <form method="post" asp-page-handler="MarkFailed">
                                <input type="hidden" name="candidateId" value="@candidate.Id" />
                                <button type="submit" class="item" disabled="@(!candidate.CanMarkFailed)">Mark failed</button>
                            </form>
                            <form method="post" asp-page-handler="CreateRetestPayment">
                                <input type="hidden" name="candidateId" value="@candidate.Id" />
                                <button type="submit" class="item" disabled="@(!candidate.CanCreateRetestPayment)">Create retest payment</button>
                            </form>
                            <button type="button" class="item" data-open-modal="refundModal-@candidate.Id" disabled="@(!candidate.CanFlagRefund)">Flag refund requested</button>
                            @if (candidate.CanSendYouthProgram)
                            {
                                <form method="post" asp-page-handler="SendYouthProgram">
                                    <input type="hidden" name="candidateId" value="@candidate.Id" />
                                    <button type="submit" class="item">Send Youth Program instructions</button>
                                </form>
                            }
                            <hr>
                            <form method="post" asp-page-handler="DeleteCandidate">
                                <input type="hidden" name="candidateId" value="@candidate.Id" />
                                <button type="submit" class="item danger" disabled="@(!candidate.CanDelete)">Delete (no-show / withdrew)</button>
                            </form>
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<footer class="roster">
    <div class="section-head" style="margin:0">
        <div>
            <p class="eyebrow">Volunteer examiners</p>
            <h2>VE roster</h2>
        </div>
        @if (Model.CanEdit)
        {
            <button type="button" class="btn-secondary btn-sm" data-open-modal="addVeModal">+ Add VE</button>
        }
    </div>
    <div class="roster-list">
        @if (Model.VeRoster.Count == 0)
        {
            <span class="mono">No VEs on this session's roster yet.</span>
        }
        @foreach (var ve in Model.VeRoster)
        {
            <span class="ve-chip">
                @ve.CallSign — @ve.Name
                @if (Model.CanEdit)
                {
                    <form method="post" asp-page-handler="RemoveVe">
                        <input type="hidden" name="volunteerExaminerId" value="@ve.Id" />
                        <button type="submit" class="x" title="Remove from roster">✕</button>
                    </form>
                }
            </span>
        }
    </div>
</footer>

@if (Model.CanDeleteSession)
{
    <!-- Delete session modal — TeamAdmin/SystemAdmin-only, see TODO.md's "delete a session outright" feature request -->
    <div class="modal-backdrop" id="deleteSessionModal">
        <div class="modal">
            <h3>Delete session @Model.Session.BreadcrumbLabel?</h3>
            <p>
                This permanently deletes this session, along with @Model.Candidates.Count candidate(s),
                every payment record attached to them, and @Model.VeRoster.Count VE roster assignment(s).
                <b>This cannot be undone.</b>
            </p>
            <form method="post" asp-page-handler="DeleteSession">
                <div class="modal-actions">
                    <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                    <button type="submit" class="btn-danger btn-sm">Delete session</button>
                </div>
            </form>
        </div>
    </div>
}

@if (Model.CanEdit)
{
    <!-- Retained amount override modal -->
    <div class="modal-backdrop" id="retainedAmountOverrideModal">
        <div class="modal">
            <h3>Override total retained for this session</h3>
            <p class="session-sub">
                The default is @Model.Session.FeeLine, applied per candidate and summed. Most sessions'
                real costs (pencils, paper, postage) are a flat session expense, not a per-candidate
                one — enter the actual total your team is keeping from this session instead. Leave
                blank to clear the override and go back to the per-candidate default.
            </p>
            <form method="post" asp-page-handler="SetRetainedAmountOverride">
                <div class="field">
                    <label for="retainedAmountOverride">Total retained ($)</label>
                    <input id="retainedAmountOverride" name="overrideAmount" type="number" step="0.01" min="0" value="@Model.Session.RetainedAmountOverrideRawValue" placeholder="Use per-candidate default" />
                </div>
                <div class="modal-actions">
                    <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                    <button type="submit" class="btn-primary btn-sm">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add VE modal -->
    <div class="modal-backdrop" id="addVeModal">
        <div class="modal">
            <h3>Add VE to roster</h3>
            <form method="post" asp-page-handler="AddVe">
                <div class="field"><label for="veCallSign">Call sign</label><input id="veCallSign" name="callSign" required /></div>
                <div class="field"><label for="veName">Name</label><input id="veName" name="name" /></div>
                <div class="modal-actions">
                    <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                    <button type="submit" class="btn-primary btn-sm">Add VE</button>
                </div>
            </form>
        </div>
    </div>

    @foreach (var candidate in Model.Candidates.Where(c => !c.IsWithdrawn))
    {
        <div class="modal-backdrop" id="emailHistoryModal-@candidate.Id">
            <div class="modal">
                <h3>Email history — @candidate.DisplayName</h3>
                @if (candidate.EmailHistory.Count == 0)
                {
                    <p class="mono">No emails sent yet.</p>
                }
                else
                {
                    <table>
                        <tbody>
                            @foreach (var line in candidate.EmailHistory)
                            {
                                <tr><td>@line.Label</td><td class="mono">@line.SentDisplay</td></tr>
                            }
                        </tbody>
                    </table>
                }
                <div class="modal-actions">
                    <button type="button" class="btn-secondary btn-sm" data-close-modal>Close</button>
                </div>
            </div>
        </div>

        <div class="modal-backdrop" id="frnModal-@candidate.Id">
            <div class="modal">
                <h3>Add / edit FRN</h3>
                <form method="post" asp-page-handler="SetFrn">
                    <input type="hidden" name="candidateId" value="@candidate.Id" />
                    <div class="field"><label for="frn-@candidate.Id">FRN</label><input id="frn-@candidate.Id" name="frn" required /></div>
                    <div class="modal-actions">
                        <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                        <button type="submit" class="btn-primary btn-sm">Save</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="modal-backdrop" id="refundModal-@candidate.Id">
            <div class="modal">
                <h3>Flag refund requested</h3>
                <form method="post" asp-page-handler="FlagRefund">
                    <input type="hidden" name="paymentId" value="@candidate.PrimaryPaymentId" />
                    <div class="field"><label for="notes-@candidate.Id">Notes</label><textarea id="notes-@candidate.Id" name="notes" rows="3"></textarea></div>
                    <div class="modal-actions">
                        <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                        <button type="submit" class="btn-primary btn-sm">Flag refund</button>
                    </div>
                </form>
            </div>
        </div>
    }
}
