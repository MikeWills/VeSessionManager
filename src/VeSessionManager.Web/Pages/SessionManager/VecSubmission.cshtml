@page
@model VeSessionManager.Web.Pages.SessionManager.VecSubmissionModel
@{
    ViewData["Title"] = "VEC Submission";
    ViewData["ActiveNav"] = "VecSubmission";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">@Model.PendingCount session(s) pending submission</p>
        <h1>VEC Submission</h1>
    </div>
</div>

@if (Model.AvailableTeams.Count > 1)
{
    <div class="filters" style="margin-bottom:16px;">
        @foreach (var team in Model.AvailableTeams)
        {
            <a class="filter-pill @(team.Id == Model.TeamId ? "active" : "")" asp-page="./VecSubmission" asp-route-teamId="@team.Id">@team.Name</a>
        }
    </div>
}

@if (!Model.HasTeamContext)
{
    <p>No team context for this account — VEC submission tracking is per-team.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Session</th>
                <th>VEC</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Sessions.Count == 0)
            {
                <tr><td colspan="4">No active sessions yet.</td></tr>
            }
            @foreach (var session in Model.Sessions)
            {
                <tr>
                    <td>
                        <div class="session-title">@session.DateLine</div>
                        <div class="session-sub">@session.ExamToolsSessionId</div>
                    </td>
                    <td>@session.VecName</td>
                    <td><span class="chip @session.ChipClass">@session.ChipLabel</span></td>
                    <td class="row-actions">
                        @if (!session.Submitted && Model.CanEdit)
                        {
                            <form method="post" asp-page-handler="MarkSubmitted">
                                <input type="hidden" name="sessionId" value="@session.Id" />
                                <button type="submit" class="btn-secondary btn-sm">Mark submitted</button>
                            </form>
                        }
                        <a class="view-link" asp-page="./Detail" asp-route-id="@session.Id">View →</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
