@page
@model VeSessionManager.Web.Pages.SessionManager.IndexModel
@{
    ViewData["Title"] = "Sessions";
    ViewData["ActiveNav"] = "Sessions";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Sessions</p>
        <h1>Sessions</h1>
    </div>
</div>

<form method="get" id="sessionFilters" class="filters" style="margin-bottom:16px; align-items:flex-start;">
    <input type="hidden" name="applied" value="true" />
    @* Applying a filter posts the whole form, and "applied" makes OnGetAsync save what it receives
       over the remembered cookie. Without these two the save wrote Sort="" every time, so choosing
       a filter silently discarded the column sort the user had picked. *@
    <input type="hidden" name="sort" value="@Model.Sort" />
    <input type="hidden" name="dir" value="@Model.SortDirection" />

    <div class="filter-dropdown">
        <button type="button" class="kebab @(Model.Status.Count > 0 ? "active" : "")">Status: @Model.StatusSummaryLabel <i class="bi bi-caret-down-fill" aria-hidden="true"></i></button>
        <div class="menu">
            @* One filter value, two chips: the SQL rule is "not cancelled and not completed", which
               renders as Active or Upcoming depending on whether the session has started. See
               IndexModel.StatusLabel for why this is not two separate filters. *@
            <label class="item"><input type="checkbox" name="status" value="Active" @(Model.Status.Contains("Active") ? "checked" : "") /> Active or upcoming</label>
            <label class="item"><input type="checkbox" name="status" value="RescheduleFlagged" @(Model.Status.Contains("RescheduleFlagged") ? "checked" : "") /> Reschedule flagged</label>
            <label class="item"><input type="checkbox" name="status" value="Completed" @(Model.Status.Contains("Completed") ? "checked" : "") /> Completed</label>
            <label class="item"><input type="checkbox" name="status" value="Cancelled" @(Model.Status.Contains("Cancelled") ? "checked" : "") /> Cancelled</label>
            <hr />
            @* Separated by a rule because this cuts across the four lifecycle states above rather
               than being another one of them — see KnownStatuses in the page model. *@
            <label class="item"><input type="checkbox" name="status" value="PendingVecSubmission" @(Model.Status.Contains("PendingVecSubmission") ? "checked" : "") /> Pending VEC submission</label>
            <hr />
            <button type="submit" class="item">Apply</button>
        </div>
    </div>

    <div class="filter-dropdown">
        <button type="button" class="kebab @(Model.DateRangeSummaryLabel != "Any time" ? "active" : "")">Date range: @Model.DateRangeSummaryLabel <i class="bi bi-caret-down-fill" aria-hidden="true"></i></button>
        <div class="menu" style="width:240px;">
            <label class="item" style="display:block;">
                <span style="display:block; margin-bottom:4px;">Preset</span>
                @* .menu-input rather than an inline style: an inline font-size can't be overridden
                   by a media query, and anything under 16px makes iOS Safari zoom the page on focus
                   and never zoom back. See the "Form field" comment in app.css. *@
                <select name="dateRange" class="menu-input">
                    <option value="">Any time</option>
                    <option value="Upcoming" selected="@(Model.DateRange == "Upcoming")">Upcoming</option>
                    <option value="Last7PlusUpcoming" selected="@(Model.DateRange == "Last7PlusUpcoming")">Last 7 + Upcoming</option>
                    @foreach (var preset in VeSessionManager.Web.Pages.SessionManager.IndexModel.DateRangePresets)
                    {
                        <option value="@preset.Key" selected="@(preset.Key == Model.DateRange)">@preset.Value.Label</option>
                    }
                </select>
            </label>
            <hr />
            <div class="item" style="cursor:default;">
                <span style="display:block; margin-bottom:4px;">Custom range (overrides preset)</span>
                <input type="date" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="menu-input" />
                <input type="date" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="menu-input" />
            </div>
            <hr />
            <button type="submit" class="item">Apply</button>
        </div>
    </div>

    @if (Model.AvailableTeams.Count > 1)
    {
        <partial name="_TeamPicker" model="new VeSessionManager.Web.TeamPicker(Model.TeamId, Model.AvailableTeams, Model.TeamSummaryLabel)" />
    }
</form>

@* Sort headers are server-rendered links, not app.js's client-side sorter (note there's no
   `data-sortable` on this table): this list pages server-side, so reordering just the rows on
   screen would look like — but not be — a sort of the whole result set. Each href is the next
   state in the ascending → descending → unsorted cycle; the ▲/▼ arrow is driven by aria-sort, the
   same CSS the client-sorted tables use. *@
<div class="table-scroll">
<table class="cards">
    <thead>
        <tr>
            @{
                var sortColumns = new (string Key, string Label)[]
                {
                    ("date", "Session"),
                    ("extid", "Session ID"),
                    ("team", "Team"),
                    ("vec", "VEC"),
                    ("candidates", "Candidates"),
                    ("status", "Status"),
                    ("vecsubmission", "VEC submission")
                };
            }
            @foreach (var column in sortColumns)
            {
                <th class="sortable" aria-sort="@Model.SortAria(column.Key)">
                    <a href="@Model.BuildSortUrl(column.Key)">@column.Label<span class="sort-arrow" aria-hidden="true"></span></a>
                </th>
            }
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Sessions.Count == 0)
        {
            <tr><td colspan="9">No sessions match this filter.</td></tr>
        }
        @foreach (var session in Model.Sessions)
        {
            <tr class="@(session.IsPast ? "row-past" : "")">
                <td>
                    <div class="session-title">
                        @session.TitleLine
                        @if (session.RescheduleFlagged)
                        {
                            <span class="flag" title="Reschedule flagged for review"><i class="bi bi-flag-fill" aria-hidden="true"></i></span>
                        }
                    </div>
                    <div class="session-sub">@session.SubLine</div>
                </td>
                <td class="mono">@session.ExtId</td>
                <td>@session.TeamName</td>
                <td>@session.VecName</td>
                <td class="count">@session.CandidateCount</td>
                <td><span class="chip @session.StatusChipClass">@session.StatusChipLabel</span></td>
                <td><span class="chip @session.VecSubmissionChipClass">@session.VecSubmissionChipLabel</span></td>
                @* Hands the detail page this exact view — every filter, the sort and the page number — so its
                       back link returns here rather than to an unfiltered first page. *@
                <td><a class="view-link" asp-page="./Detail" asp-route-id="@session.Id"
                       asp-route-return="@Model.BuildPageUrl(Model.PageNumber)">View <i class="bi bi-arrow-right" aria-hidden="true"></i></a></td>
                @* Row action menu (requested 2026-07-30) — same kebab/menu component the candidate
                   roster on the Detail page uses. Every item posts the session id and is re-authorized
                   server-side; the Can* flags only decide what's worth rendering. *@
                <td class="row-actions">
                    @if (session.HasAnyAction)
                    {
                        <button type="button" class="kebab"><i class="bi bi-three-dots-vertical" aria-hidden="true"></i></button>
                        <div class="menu">
                            @if (session.CanMarkSubmitted)
                            {
                                <form method="post" action="@Model.BuildActionUrl("MarkSubmitted")" asp-antiforgery="true">
                                    <input type="hidden" name="sessionId" value="@session.Id" />
                                    <button type="submit" class="item">Mark submitted to VEC</button>
                                </form>
                            }
                            @if (session.CanMarkCompleted)
                            {
                                <form method="post" action="@Model.BuildActionUrl("MarkCompleted")" asp-antiforgery="true">
                                    <input type="hidden" name="sessionId" value="@session.Id" />
                                    <button type="submit" class="item">Mark session completed</button>
                                </form>
                            }
                            @if (session.CanClearFlag)
                            {
                                <form method="post" action="@Model.BuildActionUrl("ClearFlag")" asp-antiforgery="true">
                                    <input type="hidden" name="sessionId" value="@session.Id" />
                                    <button type="submit" class="item">Clear reschedule flag</button>
                                </form>
                            }
                            @if (session.CanDelete)
                            {
                                @if (session.CanMarkSubmitted || session.CanMarkCompleted || session.CanClearFlag)
                                {
                                    <hr />
                                }
                                <button type="button" class="item danger" data-open-modal="deleteSessionModal-@session.Id">Delete session</button>
                            }
                        </div>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

@* One confirmation modal per deletable row — matches the per-item modal pattern the Detail page
   already uses for candidate refund/FRN. Bounded by page size (max 100). *@
@foreach (var session in Model.Sessions.Where(s => s.CanDelete))
{
    <div class="modal-backdrop" id="deleteSessionModal-@session.Id">
        <div class="modal">
            <h3>Delete session @session.TitleLine?</h3>
            <p>
                This permanently deletes the session, along with its @session.CandidateCount candidate(s),
                every payment record attached to them, and its VE roster assignments.
                <b>This cannot be undone.</b>
            </p>
            <form method="post" action="@Model.BuildActionUrl("DeleteSession")" asp-antiforgery="true">
                <input type="hidden" name="sessionId" value="@session.Id" />
                <div class="modal-actions">
                    <button type="button" class="btn-secondary btn-sm" data-close-modal>Cancel</button>
                    <button type="submit" class="btn-danger btn-sm">Delete session</button>
                </div>
            </form>
        </div>
    </div>
}

<div class="pagination">
    @if (Model.TotalCount > 0)
    {
        <span class="pagination-summary">
            Showing @(((Model.PageNumber - 1) * Model.PageSize) + 1)–@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount)) of @Model.TotalCount
        </span>
        <div class="pagination-controls filters">
            @if (Model.PageNumber > 1)
            {
                <a class="filter-pill" href="@Model.BuildPageUrl(Model.PageNumber - 1)"><i class="bi bi-arrow-left" aria-hidden="true"></i> Prev</a>
            }
            <span class="pagination-page">Page @Model.PageNumber of @Model.TotalPages</span>
            @if (Model.PageNumber < Model.TotalPages)
            {
                <a class="filter-pill" href="@Model.BuildPageUrl(Model.PageNumber + 1)">Next <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
            }
        </div>
    }
    else
    {
        <span></span>
    }
    <select name="pageSize" form="sessionFilters" class="filter-select" data-autosubmit>
        @foreach (var size in VeSessionManager.Web.Pages.SessionManager.IndexModel.AllowedPageSizes)
        {
            <option value="@size" selected="@(size == Model.PageSize)">@size per page</option>
        }
    </select>
</div>
