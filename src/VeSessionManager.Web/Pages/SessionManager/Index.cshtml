@page
@model VeSessionManager.Web.Pages.SessionManager.IndexModel
@{
    ViewData["Title"] = "Sessions";
    ViewData["ActiveNav"] = "Sessions";
    Layout = "_AppLayout";
}

<div class="page-head">
    <div>
        <p class="eyebrow">Sessions</p>
        <h1>Sessions</h1>
    </div>
    <div class="filters">
        <a class="filter-pill @(Model.ActiveFilter == "Upcoming" ? "active" : "")" asp-page="./Index" asp-route-filter="Upcoming">Upcoming</a>
        <a class="filter-pill @(Model.ActiveFilter == "NeedsReview" ? "active" : "")" asp-page="./Index" asp-route-filter="NeedsReview">Needs review</a>
        <a class="filter-pill @(Model.ActiveFilter == "Past" ? "active" : "")" asp-page="./Index" asp-route-filter="Past">Past</a>
        <a class="filter-pill @(Model.ActiveFilter == "All" ? "active" : "")" asp-page="./Index" asp-route-filter="All">All</a>
    </div>
</div>

<table>
    <thead>
        <tr>
            <th>Session</th>
            <th>VEC</th>
            <th>Candidates</th>
            <th>Status</th>
            <th>VEC submission</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Sessions.Count == 0)
        {
            <tr><td colspan="6">No sessions match this filter.</td></tr>
        }
        @foreach (var session in Model.Sessions)
        {
            <tr>
                <td>
                    <div class="session-title">
                        @session.TitleLine
                        @if (session.RescheduleFlagged)
                        {
                            <span class="flag" title="Reschedule flagged for review">⚑</span>
                        }
                    </div>
                    <div class="session-sub">@session.SubLine</div>
                </td>
                <td>@session.VecName</td>
                <td class="count">@session.CandidateCount</td>
                <td><span class="chip @session.StatusChipClass">@session.StatusChipLabel</span></td>
                <td><span class="chip @session.VecSubmissionChipClass">@session.VecSubmissionChipLabel</span></td>
                <td><a class="view-link" asp-page="./Detail" asp-route-id="@session.Id">View →</a></td>
            </tr>
        }
    </tbody>
</table>
