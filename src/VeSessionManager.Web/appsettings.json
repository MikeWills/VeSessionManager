{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../../vesessionmanager.db"
  },
  // Blank on purpose. ARRL has no sandbox and no dry-run, so a real value here would make
  // every developer machine and every test run capable of filing a real session with a real
  // VEC. Only appsettings.Production.json carries the URL. See ArrlSubmissionOptions.
  "ArrlSubmission": {
    "UploadUrl": "",
    "ArchiveRootPath": ""
  },
  "App": {
    "PublicBaseUrl": "https://localhost:5158"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/web-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
