{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../../vesessionmanager.db"
  },
  "App": {
    "PublicBaseUrl": "https://localhost:5158"
  },
  // Mirrors the Worker's base config. Without these, Web fell back to the SquareOptions /
  // ExamToolsOptions code defaults — which differ from the Worker's: examtools.dev rather than
  // alpha.exam.tools. The Production override alone was not enough, because the drift starts here
  // and so also affected Development and Test. Host/environment only; credentials are per-Team.
  "ExamTools": {
    "BaseUrl": "https://alpha.exam.tools/"
  },
  "Square": {
    "Environment": "Sandbox"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/web-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
