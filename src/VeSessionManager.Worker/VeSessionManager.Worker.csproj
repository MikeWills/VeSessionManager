<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-VeSessionManager.Worker-7144504e-98be-4ccd-ab50-694b48bd088d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VeSessionManager.Core\VeSessionManager.Core.csproj" />
  </ItemGroup>

  <!-- JobTick is internal on purpose: nothing outside this project should be wrapping ticks. Granting
       the test project access is the cheaper trade than making it public to be testable. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>VeSessionManager.Worker.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Shared config, linked rather than copied: the same physical files are used by both hosts, so
       Square/ExamTools cannot drift between them again (see src/Shared/appsettings.Shared.json). -->
  <ItemGroup>
    <Content Include="../Shared/appsettings.Shared*.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
