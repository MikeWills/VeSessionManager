{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../../vesessionmanager.db"
  },
  "Jobs": {
    "SessionIngestionIntervalSeconds": 300,
    "DayBeforeReminderIntervalHours": 24,
    "FccDailyWatcherIntervalHours": 12,
    "FccDailyWatcherStartHourEt": 8,
    "FccWeeklyCatchupIntervalHours": 24,
    "FccWeeklyCatchupDayOfWeek": "Monday",
    "PaymentReminderIntervalHours": 24,
    "PiiPurgeIntervalHours": 24,
    "SquareLinkPurgeIntervalHours": 24
  },
  "App": {
    "PublicBaseUrl": "https://localhost:5158"
  },
  "ExamTools": {
    "BaseUrl": "https://alpha.exam.tools/"
  },
  "Square": {
    "Environment": "Sandbox"
  },
  "FccUls": {
    "BaseUrl": "https://data.fcc.gov/download/pub/uls/"
  },
  "PaymentReminder": {
    "UnmatchedReviewWindowDays": 5
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/worker-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
